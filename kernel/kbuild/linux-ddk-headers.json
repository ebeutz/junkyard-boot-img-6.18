      "drivers/usb", "sound/usb", "include", "include/uapi"]},
  "xhci_headers": {"kind": "ddk_headers",
    "linux_includes": ["drivers/usb", "drivers/usb/host"]},
  "all_headers_unsafe": {"kind": "ddk_headers", "includes": ["."]}
}
