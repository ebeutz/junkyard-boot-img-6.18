# SPDX-License-Identifier: GPL-2.0
#
# kernel/kbuild.mk — build a device's kernel, modules and device tree with make.
#
#   make -f kernel/kbuild.mk DEVICE=<device> [-j N] [dist|config|kernel|modules|dtbs|nconfig|clean]
#
# The top-level Makefile's .build_kernel runs `dist`. Everything here is plain
# kbuild against the device's kernel tree (kernel/source-<device>/), with the
# tree's prebuilt clang. There is no Bazel/Kleaf anywhere in the build: the
# vendor modules' Kleaf BUILD files were turned into Kbuild once, by
# tools/bazel2kbuild.py (see kernel/kbuild/README.md), and that output is
# committed (the <package>/Kbuild files in the per-device patches plus
# kernel/kbuild/<device>-modules.mk).
#
# Outputs land in kernel/source-<device>/out/<device>/dist/ with the names and
# layout Kleaf's dist had, because that is what the rootfs and boot stages read:
#   Image Image.lz4 vmlinux System.map vmlinux.symvers kernel_aarch64_Module.symvers
#   kernel_aarch64_dot_config modules.builtin modules.builtin.modinfo
#   kernel-headers.tar.gz {vendor,system}_dlkm_staging_archive.tar.gz
#   {vendor_kernel_boot,vendor_dlkm,system_dlkm}.modules.load
#   *.dtb dtb.img *.dtbo dtbo.img
#
# How the Kleaf model maps onto one make build:
#  - ONE kernel config: the base defconfig, the device's defconfig fragments,
#    the DDK modules' own defconfigs and this repo's fragments, merged and
#    resolved with a Kconfig that also sources the vendor Kconfig (the device's
#    Kconfig.ext files and the DDK modules' Kconfigs). Kleaf built a GKI from
#    the base defconfig and a second "device" config on top for the modules;
#    with no KMI to keep, one config for both is the same kernel, built once.
#    The wrapper Kconfig goes through upstream's KBUILD_KCONFIG, so the kernel
#    tree needs no Kconfig.ext hook.
#  - external modules: one make invocation per module, each with its own MO=
#    output directory, in dependency order, each given exactly its direct deps'
#    Module.symvers -- what Kleaf's per-module sandboxes did. A module's
#    Module.symvers is also copied to the path Kleaf restored it to
#    ($(MOUT)/<package>/[<name>_]Module.symvers, i.e. COMMON_OUT_DIR), because
#    the Makefile-based modules (soc/gs, mali, ...) look for their deps there.
#  - installed: the GKI modules (KERNEL_GKI_MODULES) and the device's in-tree
#    ones (KERNEL_VENDOR_INTREE_MODULES) from the kernel, and every external
#    module the device's module groups list. Like Kleaf, nothing else: no test
#    modules, no module that is only another module's dependency.
#  - modules are stripped (INSTALL_MOD_STRIP) and, with KERNEL_SIGN_MODULES=1,
#    signed by modules_install with the build's own key, which the same
#    build's Image trusts. gs201_defconfig turns CONFIG_MODULE_SIG_ALL off
#    (Google signs separately), so it is switched back on for modules_install
#    only. This replaces tools/sign-kernel-modules.sh, which re-signed Kleaf's
#    archives with the GKI key because Kleaf's device and GKI builds had
#    different keys.

ifeq ($(DEVICE),)
$(error kernel/kbuild.mk: DEVICE is not set)
endif
include devices/$(DEVICE).mk

REPO   := $(abspath .)
SRC    := $(REPO)/kernel/source-$(DEVICE)
KTREE  := $(SRC)/$(KERNEL_TREE)
OUT    := $(SRC)/out/$(DEVICE)
KOUT   := $(OUT)/kernel
MOUT   := $(OUT)/modules
STAGE  := $(OUT)/staging
DIST   := $(OUT)/dist
CLANG  := $(SRC)/prebuilts/clang/host/linux-x86/clang-$(KERNEL_CLANG_VERSION)

# Generated by `kbuild-regen` (below), which may run before it exists.
ifneq ($(filter kbuild-regen,$(MAKECMDGOALS)),)
-include $(KERNEL_EXT_MODULES_MK)
else
include $(KERNEL_EXT_MODULES_MK)
endif

KCONFIG_WRAPPER := $(KOUT)/Kconfig.junkyard

# Every make invocation against the kernel tree. Recipes that run it are marked
# `+`: make only hands its jobserver to a sub-make it can see is one, and it
# cannot see $(MAKE) through this variable (the build then ran at -j1).
# KBUILD_KCONFIG and the vendor
# Kconfig prefixes must be the same on every one: kbuild re-runs syncconfig
# whenever a Kconfig file changes, and would otherwise do it without the vendor
# symbols and drop them from .config.
KMAKE = $(MAKE) -C $(KTREE) O=$(KOUT) ARCH=arm64 LLVM=$(CLANG)/bin/ PAHOLE=$(PAHOLE) \
	KBUILD_KCONFIG=$(KCONFIG_WRAPPER) $(KERNEL_KCONFIG_VARS)

# pahole generates the BTF (CONFIG_DEBUG_INFO_BTF). It is the build host's, and
# it has to be recent: 1.25 (Ubuntu 24.04) stops at 4096 per-CPU variables
# ("Reached the limit of per-CPU variables") and vmlinux then fails to link with
# "Failed to generate BTF". Kleaf used 1.31; 1.32 is tested here. Point PAHOLE
# at a newer one if the host's is too old. PAHOLE_MIN is major*100 + minor.
PAHOLE ?= pahole
PAHOLE_MIN := 127

# Base defconfig, then the device's fragments, the DDK modules' defconfigs, then
# this repo's (last, so they win). All but the base are checked afterwards.
CONFIG_FRAGMENTS := \
	$(addprefix $(SRC)/,$(KERNEL_DEFCONFIG_FRAGMENTS) $(EXT_MODULE_DEFCONFIGS)) \
	$(addprefix $(REPO)/,$(KERNEL_LOCAL_FRAGMENTS))
# sed filters that spell out each KCONFIG_*_PREFIX the way kconfig expands it.
KCONFIG_EXPAND = $(foreach v,$(KERNEL_KCONFIG_VARS),| sed -e 's|$$($(firstword $(subst =, ,$(v))))|$(word 2,$(subst =, ,$(v)))|g')

CONFIG_INPUTS := $(KERNEL_BASE_DEFCONFIG) $(CONFIG_FRAGMENTS) $(KTREE)/Kconfig \
	$(addprefix $(SRC)/,$(KERNEL_KCONFIG_EXTS)) \
	$(addprefix $(REPO)/,$(KERNEL_EXTRA_KCONFIGS)) \
	$(REPO)/kernel/kbuild.mk $(REPO)/devices/$(DEVICE).mk $(KERNEL_EXT_MODULES_MK)

# Out-of-tree device tree, built by kbuild with dtstree= (a path relative to
# the kernel tree; outputs land beside $(KOUT)). The vendor dt-bindings go on
# the dtc include path. Upstream writes `-I $(DTC_INCLUDE)`, so a second
# directory has to carry its own -I (dtc then also sees a harmless "-I..."
# search path); ACK appends to DTC_INCLUDE from the environment instead.
DTSTREE_REL := $(shell realpath -m --relative-to=$(KTREE) $(SRC)/$(KERNEL_DTSTREE))
DTS_OUT     := $(abspath $(KOUT)/$(DTSTREE_REL))
ifneq ($(shell grep -ls 'DTC_INCLUDE +=' $(KTREE)/scripts/Makefile.dtbs $(KTREE)/scripts/Makefile.lib),)
DTC_ARGS := dtstree=$(DTSTREE_REL)
DTC_ENV  := DTC_INCLUDE=$(SRC)/$(KERNEL_DTC_INCLUDE)
else
DTC_ARGS := dtstree=$(DTSTREE_REL) \
	DTC_INCLUDE="$(SRC)/$(KERNEL_DTC_INCLUDE) -I$(KTREE)/scripts/dtc/include-prefixes"
DTC_ENV  :=
endif

.PHONY: all dist config kernel modules dtbs nconfig savedefconfig clean
all: dist

# ---------------------------------------------------------------------------
# Config

$(KOUT)/.config: $(CONFIG_INPUTS)
	@test -x $(CLANG)/bin/clang || { echo "ERROR: no clang at $(CLANG) (run 'just device=$(DEVICE) clone_kernel_source')"; exit 1; }
	@v=$$($(PAHOLE) --version 2>/dev/null | awk -F'[v.]' '{ print $$2 * 100 + $$3 }'); \
	if [ -z "$$v" ] || [ "$$v" -lt $(PAHOLE_MIN) ]; then \
	  echo "ERROR: pahole '$$($(PAHOLE) --version 2>/dev/null)' is too old for BTF (need >= 1.27);"; \
	  echo "       install a newer one, or pass PAHOLE=/path/to/pahole."; exit 1; fi
	mkdir -p $(KOUT)
	@# The kernel's top-level Kconfig with the vendor Kconfig appended. A copy
	@# rather than `source "Kconfig"`: mainmenu is only valid as the first
	@# statement of the top file. Its own source lines stay relative to srctree.
	@# A DDK module's Kconfig that a Kconfig.ext already sources (spelled with
	@# the KCONFIG_*_PREFIX variables) is skipped: kconfig rejects a second
	@# inclusion of the same file.
	cat $(addprefix $(SRC)/,$(KERNEL_KCONFIG_EXTS)) /dev/null $(KCONFIG_EXPAND) > $(KOUT)/Kconfig.ext.expanded
	{ cat $(KTREE)/Kconfig; echo; echo '# --- appended by kernel/kbuild.mk ---'; \
	  for f in $(addprefix $(REPO)/,$(KERNEL_EXTRA_KCONFIGS)) $(addprefix $(SRC)/,$(KERNEL_KCONFIG_EXTS)); do \
	    echo "source \"$$f\""; done; \
	  for k in $(EXT_MODULE_KCONFIGS); do \
	    if grep -qF "$(SRC)/$$k\"" $(KOUT)/Kconfig.ext.expanded; then continue; fi; \
	    echo "source \"$(SRC)/$$k\""; done; \
	} > $(KCONFIG_WRAPPER).tmp
	mv $(KCONFIG_WRAPPER).tmp $(KCONFIG_WRAPPER)
	$(KTREE)/scripts/kconfig/merge_config.sh -m -O $(KOUT) $(KERNEL_BASE_DEFCONFIG) $(CONFIG_FRAGMENTS) >$(KOUT)/merge_config.log
	+$(KMAKE) olddefconfig
	$(REPO)/tools/kconfig-check-fragments.sh $(KOUT)/.config $(CONFIG_FRAGMENTS)

config: $(KOUT)/.config

nconfig savedefconfig: $(KOUT)/.config
	+$(KMAKE) $@

# ---------------------------------------------------------------------------
# Kernel and in-tree modules. kbuild is incremental, so these always run.

kernel: $(KOUT)/.config
	+$(KMAKE) Image Image.lz4 modules

dtbs: kernel
	+$(DTC_ENV) $(KMAKE) $(DTC_ARGS) dtbs

# ---------------------------------------------------------------------------
# External modules, from $(KERNEL_EXT_MODULES_MK).

ext_mo = $(MOUT)/build/$(1)

# ddk: the package Kbuild written by bazel2kbuild, one module per run.
define build_ddk
	$(KMAKE) M=$(SRC)/$($(1).dir) MO=$(call ext_mo,$(1)) DDK_MODULE=$($(1).name) \
		ROOT_DIR=$(SRC) KBUILD_EXTRA_SYMBOLS="$(addprefix $(MOUT)/,$($(1).extra_symbols))" \
		modules
endef

# make: the package's own Makefile, invoked the way Kleaf's kernel_module did
# (it finds its deps' Module.symvers under COMMON_OUT_DIR itself). M is relative
# to the kernel tree, as Kleaf passed it: soc/gs's Makefile includes
# $(KERNEL_SRC)/$(M)/Makefile.preinstall.
#
# KCFLAGS is exported (empty) in the ENVIRONMENT, as Kleaf's kernel_env did.
# These Makefiles add their include paths with `KCFLAGS += ...` (e.g.
# soc/gs/Makefile.include, which mali includes), and make passes a makefile
# variable on to kbuild's sub-make only if it came from the environment. Unset,
# the additions are silently dropped; on the make command line they would
# override the `+=` instead.
ext_rel = $(shell realpath -m --relative-to=$(KTREE) $(SRC)/$(1))
define build_make
	KCFLAGS= $(MAKE) -C $(SRC)/$($(1).dir) ARCH=arm64 LLVM=$(CLANG)/bin/ \
		M=$(call ext_rel,$($(1).dir)) O=$(KOUT) MO=$(call ext_mo,$(1)) KERNEL_SRC=$(KTREE) \
		ROOT_DIR=$(SRC) COMMON_OUT_DIR=$(MOUT) OUT_DIR=$(KOUT) KERNEL_DIR=$(KERNEL_TREE) \
		modules
endef

define ext_module_rule
.PHONY: ext/$(1)
ext/$(1): kernel $(addprefix ext/,$($(1).needs))
	@echo "  MODULE  $(1)"
	+$$(call build_$($(1).kind),$(1))
	mkdir -p $$(dir $(MOUT)/$($(1).symvers))
	cp $(call ext_mo,$(1))/Module.symvers $(MOUT)/$($(1).symvers)
endef
$(foreach m,$(EXT_MODULES),$(eval $(call ext_module_rule,$(m))))

modules: $(addprefix ext/,$(EXT_MODULES))

# ---------------------------------------------------------------------------
# Install, check, and assemble dist/.

MODINST = INSTALL_MOD_PATH=$(STAGE) INSTALL_MOD_STRIP=1 DEPMOD=true \
	$(if $(filter 1,$(KERNEL_SIGN_MODULES)),CONFIG_MODULE_SIG_ALL=y) modules_install

INSTALLED_EXT := $(foreach m,$(EXT_MODULES),$(if $($(m).install),$(m)))
INTREE_KEEP   := $(KERNEL_VENDOR_INTREE_MODULES) $(shell grep -v '^\#' $(REPO)/$(KERNEL_GKI_MODULES))

# The kernel release, read when a recipe runs (it exists once `kernel` ran).
KVER_SH := $$(cat $(KOUT)/include/config/kernel.release)

# Each step is its own rule, so no shell command grows with the module count
# (one command for all of lynx's modules overflowed ARG_MAX).
.PHONY: stage install-intree install-ext assemble
stage: kernel modules dtbs
	rm -rf $(STAGE) $(DIST) $(OUT)/vendor_dlkm $(OUT)/system_dlkm $(OUT)/kernel-headers $(OUT)/order
	mkdir -p $(DIST)

# In-tree modules: install all, keep the GKI list and the device's own. GKI
# modules ship if built (Kleaf's module_implicit_outs); the device's in-tree
# ones are required (module_outs).
install-intree: stage
	@echo "  INSTALL in-tree modules"
	+@$(KMAKE) $(MODINST) >/dev/null
	@mod=$(STAGE)/lib/modules/$(KVER_SH); \
	printf '%s\n' $(INTREE_KEEP) | sed 's|^|kernel/|' | sort -u > $(OUT)/intree.keep; \
	(cd $$mod && find kernel -name '*.ko' | sort) | comm -23 - $(OUT)/intree.keep | (cd $$mod && xargs -r rm -f); \
	for m in $(KERNEL_VENDOR_INTREE_MODULES); do \
	  test -f $$mod/kernel/$$m || { echo "ERROR: KERNEL_VENDOR_INTREE_MODULES: kernel/$$m was not built (config?)"; exit 1; }; \
	done

# External modules, one install per module. Each declared out must have been
# installed. Like Kleaf, an out may be a basename or a path under the package
# (trusty's are basenames for drivers/trusty/*.ko), so it is matched by path
# suffix; the installed paths, in declaration order, go to $(OUT)/order/<id>.
order_file = $(OUT)/order/$(subst /,_,$(1))
define install_rule
.PHONY: install/$(1)
install/$(1): install-intree
	@echo "  INSTALL $(1)"
	+@$$(KMAKE) M=$(SRC)/$($(1).dir) MO=$(call ext_mo,$(1)) INSTALL_MOD_DIR=extra/$($(1).dir) $$(MODINST) >/dev/null
	@mkdir -p $(OUT)/order; : > $(call order_file,$(1)); \
	for o in $($(1).outs); do \
	  f=$$$$(cd $(STAGE)/lib/modules/$$(KVER_SH) && find extra/$($(1).dir) -path "*/$$$$o" | sort | head -n 1); \
	  test -n "$$$$f" || { echo "ERROR: $(1) did not build $$$$o (compiled out by its config?)"; exit 1; }; \
	  echo "$$$$f" >> $(call order_file,$(1)); \
	done
endef
$(foreach m,$(INSTALLED_EXT),$(eval $(call install_rule,$(m))))

install-ext: $(addprefix install/,$(INSTALLED_EXT))

# vendor_dlkm = the device's in-tree modules + the external ones, in build
# order; system_dlkm = the GKI modules.
assemble: install-ext
	printf 'kernel/%s\n' $(KERNEL_VENDOR_INTREE_MODULES) > $(OUT)/vendor.order
	cat $(foreach m,$(INSTALLED_EXT),$(call order_file,$(m))) >> $(OUT)/vendor.order
	@set -e; kver=$(KVER_SH); mod=$(STAGE)/lib/modules/$$kver; \
	echo "  DEPMOD  $$kver"; \
	depmod -b $(STAGE) -e -F $(KOUT)/System.map $$kver 2>$(OUT)/depmod.log || { cat $(OUT)/depmod.log; exit 1; }; \
	if grep -q 'needs unknown symbol' $(OUT)/depmod.log; then cat $(OUT)/depmod.log; echo "ERROR: modules need unknown symbols"; exit 1; fi; \
	for a in vendor_dlkm system_dlkm; do mkdir -p $(OUT)/$$a/lib/modules/$$kver; done; \
	(cd $(STAGE) && find lib -name '*.ko' | sort) > $(OUT)/all.list; \
	sed "s|^|lib/modules/$$kver/|" $(OUT)/vendor.order | sort > $(OUT)/vendor.list; \
	comm -23 $(OUT)/all.list $(OUT)/vendor.list > $(OUT)/system.list; \
	rsync -a --files-from=$(OUT)/vendor.list $(STAGE)/ $(OUT)/vendor_dlkm/; \
	rsync -a --files-from=$(OUT)/system.list $(STAGE)/ $(OUT)/system_dlkm/; \
	cp $(OUT)/vendor.order $(OUT)/vendor_dlkm/lib/modules/$$kver/modules.order; \
	grep -v '^#' $(REPO)/$(KERNEL_GKI_MODULES) | sed 's|^|kernel/|' \
	  | while read m; do if [ -f $$mod/$$m ]; then echo $$m; fi; done > $(OUT)/system_dlkm/lib/modules/$$kver/modules.order; \
	for a in vendor_dlkm system_dlkm; do \
	  tar czf $(DIST)/$${a}_staging_archive.tar.gz -C $(OUT)/$$a .; done; \
	python3 $(REPO)/tools/modules-load-lists.py --moddir $$mod \
	  $(addprefix --ramdisk-list $(SRC)/,$(KERNEL_VENDOR_RAMDISK_LISTS)) \
	  --vendor-order $(OUT)/vendor.order --gki-list $(REPO)/$(KERNEL_GKI_MODULES) --out $(DIST)
	@echo "  DIST    kernel, headers, device tree"
	cp $(KOUT)/arch/arm64/boot/Image $(KOUT)/arch/arm64/boot/Image.lz4 $(KOUT)/vmlinux \
	   $(KOUT)/System.map $(KOUT)/modules.builtin \
	   $(KOUT)/modules.builtin.modinfo $(DIST)/
	cp $(KOUT)/Module.symvers $(DIST)/kernel_aarch64_Module.symvers
	@# vmlinux.symvers (vmlinux's own exports) is an intermediate kbuild does
	@# not keep; Kleaf's dist had it. It is Module.symvers' vmlinux lines.
	awk -F'\t' '$$3 == "vmlinux"' $(KOUT)/Module.symvers > $(DIST)/vmlinux.symvers
	cp $(KOUT)/.config $(DIST)/kernel_aarch64_dot_config
	@# headers: the tree's arch/ and include/, plus everything the build generated
	mkdir -p $(OUT)/kernel-headers
	cd $(KTREE) && find arch include -name '*.h' -not -type d -print0 | cpio -0pdm --quiet $(OUT)/kernel-headers
	cd $(KOUT) && find . -name '*.h' -not -type d -print0 | cpio -0pdm --quiet $(OUT)/kernel-headers
	tar czf $(DIST)/kernel-headers.tar.gz -C $(OUT) kernel-headers
	cp $(addprefix $(DTS_OUT)/,$(KERNEL_DTBS) $(KERNEL_DTBOS)) $(DIST)/
	cd $(DIST) && cat $(notdir $(KERNEL_DTBS)) > dtb.img
	cd $(DIST) && python3 $(REPO)/tools/mkdtboimg.py dtbo.img $(KERNEL_DTBOS)
	@echo "kernel $(KVER_SH): $$(find $(STAGE) -name '*.ko' | wc -l) modules -> $(DIST)"

dist: assemble

clean:
	rm -rf $(OUT)

# ---------------------------------------------------------------------------
# Maintenance: regenerate the module Kbuild files (written into the kernel
# tree's packages) and $(KERNEL_EXT_MODULES_MK) from the vendor tree's
# BUILD.bazel files, with the device's KBUILD_GEN_* inputs. Not part of a build;
# see kernel/kbuild/README.md for when to run it and how to carry the result
# into the per-device patches.
.PHONY: kbuild-regen
kbuild-regen:
	python3 $(REPO)/tools/bazel2kbuild.py --root $(SRC) --device $(DEVICE) \
		$(addprefix --module ,$(KBUILD_GEN_ROOTS)) \
		$(addprefix --flag ,$(KBUILD_GEN_FLAGS)) \
		$(addprefix --condition ,$(KBUILD_GEN_CONDITIONS)) \
		$(addprefix --kernel-build-headers ,$(KBUILD_GEN_KERNEL_HEADERS)) \
		$(if $(KBUILD_GEN_KERNEL_PKG),--kernel-headers $(REPO)/$(KBUILD_GEN_KERNEL_PKG)) \
		--kernel-dir $(or $(KBUILD_GEN_KERNEL_DIR),common) --kernel-path $(KERNEL_TREE) \
		--manifest $(KERNEL_EXT_MODULES_MK) --write-kbuild
