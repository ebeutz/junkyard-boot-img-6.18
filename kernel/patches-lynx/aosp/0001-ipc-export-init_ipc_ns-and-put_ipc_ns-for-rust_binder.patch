From: junkyard
Subject: [PATCH] ipc: export init_ipc_ns and put_ipc_ns for rust_binder.ko

ACK (and so GrapheneOS kernel_common-6.18) builds Rust Binder as the GKI
module rust_binder.ko, and rust_binderfs.c references init_ipc_ns and
put_ipc_ns only under CONFIG_IPC_NS. GKI keeps SYSVIPC, POSIX_MQUEUE and
therefore IPC_NS off, so neither symbol ever needed exporting there.

The junkyard defconfig fragment enables SYSVIPC + POSIX_MQUEUE + USER_NS
(k3s/runc need IPC namespaces), IPC_NS follows, and modpost then fails
the GKI build:

  ERROR: modpost: "put_ipc_ns" [drivers/android/binder/rust_binder.ko] undefined!
  ERROR: modpost: "init_ipc_ns" [drivers/android/binder/rust_binder.ko] undefined!

Export both, GPL-only. lynx-only (kernel/patches-lynx/): felix's 6.1 tree
has no Rust Binder.
---
diff --git a/ipc/msgutil.c b/ipc/msgutil.c
index 7a03f6d03de3..55a8d19350c8 100644
--- a/ipc/msgutil.c
+++ b/ipc/msgutil.c
@@ -4,6 +4,7 @@
  * Copyright (C) 1999, 2004 Manfred Spraul
  */
 
+#include <linux/export.h>
 #include <linux/spinlock.h>
 #include <linux/init.h>
 #include <linux/security.h>
@@ -35,6 +36,13 @@ struct ipc_namespace init_ipc_ns = {
 #endif
 	.ns.ns_type = ns_common_type(&init_ipc_ns),
 };
+/*
+ * junkyard (lynx): exported for rust_binder.ko. ACK builds Rust Binder as a GKI
+ * module and only references init_ipc_ns under CONFIG_IPC_NS, which GKI leaves
+ * off; our defconfig fragment turns SYSVIPC/POSIX_MQUEUE (and so IPC_NS) on for
+ * k3s, and without this export modpost fails the GKI build.
+ */
+EXPORT_SYMBOL_GPL(init_ipc_ns);
 
 struct msg_msgseg {
 	struct msg_msgseg *next;
diff --git a/ipc/namespace.c b/ipc/namespace.c
index 59b12fcb40bd..101b3c5e872d 100644
--- a/ipc/namespace.c
+++ b/ipc/namespace.c
@@ -4,6 +4,7 @@
  * Copyright (C) 2006 Pavel Emelyanov <xemul@openvz.org> OpenVZ, SWsoft Inc.
  */
 
+#include <linux/export.h>
 #include <linux/ipc.h>
 #include <linux/msg.h>
 #include <linux/ipc_namespace.h>
@@ -208,6 +209,8 @@ void put_ipc_ns(struct ipc_namespace *ns)
 			schedule_work(&free_ipc_work);
 	}
 }
+/* junkyard (lynx): exported for rust_binder.ko — see init_ipc_ns in msgutil.c. */
+EXPORT_SYMBOL_GPL(put_ipc_ns);
 
 static struct ns_common *ipcns_get(struct task_struct *task)
 {
