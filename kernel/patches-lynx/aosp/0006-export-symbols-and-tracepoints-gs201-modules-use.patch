From: junkyard
Subject: [PATCH] export symbols and tracepoints the gs201 modules use

GrapheneOS's kernel_common-6.18 GKI exports these (from ACK); android-
mainline does not, and gs201 vendor modules lynx builds use them:

  plist_add, plist_del                  exynos_pm_qos.ko
  seq_put_decimal_ull_width             pixel_stat_mm.ko
  tracepoints cma_alloc_{start,finish},
    mm_vmscan_direct_reclaim_{begin,end} pixel_stat_mm.ko (registers probes)
  tracepoints workqueue_execute_{start,end}
                                        dss.ko (debug-snapshot, registers probes)

Export them, GPL-only, at the places GrapheneOS does. lynx-only
(kernel/patches-lynx/).
---
diff --git a/fs/seq_file.c b/fs/seq_file.c
index 456c78719fd0..bcc736985a87 100644
--- a/fs/seq_file.c
+++ b/fs/seq_file.c
@@ -719,6 +719,8 @@ void seq_put_decimal_ull_width(struct seq_file *m, const char *delimiter,
 overflow:
 	seq_set_overflow(m);
 }
+/* junkyard (lynx-mainline): used by gs201 pixel_stat_mm.ko */
+EXPORT_SYMBOL_GPL(seq_put_decimal_ull_width);
 
 void seq_put_decimal_ull(struct seq_file *m, const char *delimiter,
 			 unsigned long long num)
diff --git a/kernel/workqueue.c b/kernel/workqueue.c
index c1cb328bce3c..80084cedee18 100644
--- a/kernel/workqueue.c
+++ b/kernel/workqueue.c
@@ -556,6 +556,10 @@ static void show_one_worker_pool(struct worker_pool *pool);
 #define CREATE_TRACE_POINTS
 #include <trace/events/workqueue.h>
 
+/* junkyard (lynx-mainline): used by gs201 dss.ko (debug-snapshot), as GrapheneOS exports them. */
+EXPORT_TRACEPOINT_SYMBOL_GPL(workqueue_execute_start);
+EXPORT_TRACEPOINT_SYMBOL_GPL(workqueue_execute_end);
+
 #define assert_rcu_or_pool_mutex()					\
 	RCU_LOCKDEP_WARN(!rcu_read_lock_any_held() &&			\
 			 !lockdep_is_held(&wq_pool_mutex),		\
diff --git a/lib/plist.c b/lib/plist.c
index a5bef38add43..4f6cb391b7a6 100644
--- a/lib/plist.c
+++ b/lib/plist.c
@@ -23,6 +23,7 @@
  */
 
 #include <linux/bug.h>
+#include <linux/export.h>
 #include <linux/plist.h>
 
 #ifdef CONFIG_DEBUG_PLIST
@@ -112,6 +113,8 @@ void plist_add(struct plist_node *node, struct plist_head *head)
 
 	plist_check_head(head);
 }
+/* junkyard (lynx-mainline): used by gs201 exynos_pm_qos.ko */
+EXPORT_SYMBOL_GPL(plist_add);
 
 /**
  * plist_del - Remove a @node from plist.
@@ -141,6 +144,8 @@ void plist_del(struct plist_node *node, struct plist_head *head)
 
 	plist_check_head(head);
 }
+/* junkyard (lynx-mainline): used by gs201 exynos_pm_qos.ko */
+EXPORT_SYMBOL_GPL(plist_del);
 
 /**
  * plist_requeue - Requeue @node at end of same-prio entries.
diff --git a/mm/cma.c b/mm/cma.c
index e4e288a996cd..2f8d8262b88f 100644
--- a/mm/cma.c
+++ b/mm/cma.c
@@ -34,6 +34,10 @@
 #include <linux/jiffies.h>
 #include <trace/events/cma.h>
 
+/* junkyard (lynx-mainline): used by gs201 pixel_stat_mm.ko, as GrapheneOS exports them. */
+EXPORT_TRACEPOINT_SYMBOL_GPL(cma_alloc_start);
+EXPORT_TRACEPOINT_SYMBOL_GPL(cma_alloc_finish);
+
 #include "internal.h"
 #include "cma.h"
 #include "mm_init.h"
diff --git a/mm/vmscan.c b/mm/vmscan.c
index 2d489dbdeb2f..f42dca3b1c0d 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -73,6 +73,10 @@
 #define CREATE_TRACE_POINTS
 #include <trace/events/vmscan.h>
 
+/* junkyard (lynx-mainline): used by gs201 pixel_stat_mm.ko, as GrapheneOS exports them. */
+EXPORT_TRACEPOINT_SYMBOL_GPL(mm_vmscan_direct_reclaim_begin);
+EXPORT_TRACEPOINT_SYMBOL_GPL(mm_vmscan_direct_reclaim_end);
+
 #undef CREATE_TRACE_POINTS
 #include <trace/hooks/vmscan.h>
 
