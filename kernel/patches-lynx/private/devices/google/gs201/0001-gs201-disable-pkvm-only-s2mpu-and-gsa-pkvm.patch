From: junkyard
Subject: [PATCH] gs201: drop pKVM-only S2MPU support from the lynx build

TODO: describe
---
diff --git a/BUILD.bazel b/BUILD.bazel
index e4880b3..c7d19a1 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -116,7 +116,6 @@ kernel_module(
         "drivers/soc/google/modemctl/google_modemctl.ko",
         "drivers/soc/google/pixel_stat/mm/pixel_stat_mm.ko",
         "drivers/soc/google/pixel_stat/pixel_stat_sysfs.ko",
-        "drivers/soc/google/pkvm-s2mpu/pkvm-s2mpu/pkvm-s2mpu.ko",
         "drivers/soc/google/pt/slc_acpm.ko",
         "drivers/soc/google/pt/slc_dummy.ko",
         "drivers/soc/google/pt/slc_pmon.ko",
diff --git a/gs201_defconfig b/gs201_defconfig
index 357e823..f90cfe6 100644
--- a/gs201_defconfig
+++ b/gs201_defconfig
@@ -170,12 +170,17 @@ CONFIG_HARDLOCKUP_DEBUG=m
 CONFIG_HARDLOCKUP_WATCHDOG=m
 CONFIG_DBGCORE_DUMP=m
 CONFIG_SYSRQ_HOOK=m
-CONFIG_PKVM_S2MPU=m
+# junkyard (lynx): pKVM's IOMMU framework (kvm/iommu.h) is gone from ACK 6.18, and
+# these images boot kvm-arm.mode=nvhe, where pkvm-s2mpu never does anything.
+# CONFIG_PKVM_S2MPU is not set
 CONFIG_KERNEL_TOP=m
 
 # private/google-modules/soc/gs/drivers/soc/google/gsa/Kconfig
 CONFIG_GSA=m
-CONFIG_GSA_PKVM=m
+# junkyard (lynx): depends on PKVM_S2MPU (off above). GSA then uses its non-pKVM
+# path (plain runtime PM around transfers); in this tree S2MPU registration is
+# disabled outright anyway (pkvm_s2mpu.c: "if (1 || ...) return -ENODEV").
+# CONFIG_GSA_PKVM is not set
 CONFIG_GSA_GSC=m
 # FIXME: Not needed. It's here to prevent kleaf build error.
 CONFIG_TZ_PROT=m
diff --git a/vendor_ramdisk.modules.gs201 b/vendor_ramdisk.modules.gs201
index b57e01a..dc6311c 100644
--- a/vendor_ramdisk.modules.gs201
+++ b/vendor_ramdisk.modules.gs201
@@ -74,7 +74,6 @@ extra/private/google-modules/soc/gs/drivers/soc/google/pixel_stat/pixel_stat_sys
 extra/private/google-modules/soc/gs/drivers/soc/google/pixel_stat/mm/pixel_stat_mm.ko
 extra/private/google-modules/soc/gs/drivers/soc/google/dbgcore-dump.ko
 extra/private/google-modules/soc/gs/drivers/soc/google/exynos-seclog.ko
-extra/private/google-modules/soc/gs/drivers/soc/google/pkvm-s2mpu/pkvm-s2mpu/pkvm-s2mpu.ko
 extra/private/google-modules/soc/gs/drivers/soc/google/kernel-top.ko
 extra/private/google-modules/soc/gs/drivers/regulator/pmic_class.ko
 extra/private/google-modules/soc/gs/drivers/regulator/s2mpg12-regulator.ko
