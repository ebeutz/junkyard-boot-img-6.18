diff --git a/dts/gs201-lynx-usecases.dtsi b/dts/gs201-lynx-usecases.dtsi
index f5cf64b..3e16c1e 100644
--- a/dts/gs201-lynx-usecases.dtsi
+++ b/dts/gs201-lynx-usecases.dtsi
@@ -10,7 +10,13 @@
 &max77759_chg {
 	/* external boost */
 	max77759,bst-on = <&max777x9_gpio 4 GPIO_ACTIVE_HIGH>; /* MW: OTG_BOOST_EN */
-	max77759,extbst-ctl = <&max77759_tcpc_gpio 0 GPIO_ACTIVE_HIGH>;
+	/*
+	 * junkyard (lynx-linus-mainline): "-gpios" suffix added. The driver
+	 * asks for devm_gpiod_get(dev, "max77759,extbst-ctl"); the Android
+	 * Common Kernels add a gpiolib-of rename quirk mapping that con_id to
+	 * this unsuffixed property, which Linus' gpiolib does not have.
+	 */
+	max77759,extbst-ctl-gpios = <&max77759_tcpc_gpio 0 GPIO_ACTIVE_HIGH>;
 	max77759,extbst-mode = <&s2mpg12_gpio 4 GPIO_ACTIVE_HIGH>;
 	max77759,cpout-ctl =  <&p9xxx_gpio 3 GPIO_ACTIVE_HIGH>;
 
