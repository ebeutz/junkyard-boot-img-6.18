+  -Werror
+asflags-y += \
+  -DDYNAMIC_DEBUG_MODULE=1 \
+  -I$(ROOT_DIR)/common \
+  -I$(ROOT_DIR)/private/google-modules/display/common/include \
+  -I$(ROOT_DIR)/private/google-modules/display/common/include/uapi \
+  -I$(ROOT_DIR)/private/google-modules/display/samsung \
