+  $(LINUXINCLUDE)
+ccflags-y += \
+  -DDYNAMIC_DEBUG_MODULE=1 \
+  -I$(ROOT_DIR)/common \
+  -I$(ROOT_DIR)/private/google-modules/display/common/include \
+  -I$(ROOT_DIR)/private/google-modules/display/common/include/uapi \
+  -I$(ROOT_DIR)/private/google-modules/display/samsung \
+  -I$(ROOT_DIR)/private/google-modules/display/samsung/include/uapi \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/drivers/dma-buf/heaps \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/drivers/soc/google/vh/include \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/drivers/usb/host \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/drivers/usb/typec/tcpm/google \
