@@ -18,3 +18,13 @@ config GOOGLE_LOGBUFFER
 
 	  To compile this driver as a module, choose M here: the module will be
 	  called logbuffer.
+
+# junkyard (lynx-linus-mainline): the fuel gauge and wireless charger modules
+# (max1720x-battery, max77779-fg, p9221) call crc8()/crc8_populate_msb(). The
+# Android GKIs happen to build CRC8 into vmlinux; Linus' tree with the same
+# defconfig does not, and CRC8 has no prompt. Select it from here so the
+# device build produces lib/crc/crc8.ko (GS201_MODULE_OUTS) next to GBMS.
+config GOOGLE_BMS_CRC8
+	tristate
+	default GOOGLE_LOGBUFFER
+	select CRC8
