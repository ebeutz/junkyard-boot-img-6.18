diff --git a/include/soc/google/gs_platform_compat.h b/include/soc/google/gs_platform_compat.h
new file mode 100644
index 0000000..35cf3ff
--- /dev/null
+++ b/include/soc/google/gs_platform_compat.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * junkyard (lynx): 6.18 moved driver_override from struct platform_device into
+ * struct device (set with device_set_driver_override()), so a static
+ * platform_device can no longer carry it in its initializer.
+ *
+ * gs_platform_device_register_override() is platform_device_register() with the
+ * override applied after device_initialize() (which initialises its lock) and
+ * before platform_device_add() (which triggers driver matching). The DMA-mask
+ * defaults mirror platform_device_register()'s static setup_pdev_dma_masks().
+ */
+#ifndef _GS_PLATFORM_COMPAT_H
+#define _GS_PLATFORM_COMPAT_H
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/platform_device.h>
+
+static inline int gs_platform_device_register_override(struct platform_device *pdev,
+							const char *driver_override)
+{
+	int ret;
+
+	device_initialize(&pdev->dev);
+
+	pdev->dev.dma_parms = &pdev->dma_parms;
+	if (!pdev->dev.coherent_dma_mask)
+		pdev->dev.coherent_dma_mask = DMA_BIT_MASK(32);
+	if (!pdev->dev.dma_mask) {
+		pdev->platform_dma_mask = DMA_BIT_MASK(32);
+		pdev->dev.dma_mask = &pdev->platform_dma_mask;
+	}
+
+	ret = device_set_driver_override(&pdev->dev, driver_override);
+	if (ret) {
+		put_device(&pdev->dev);
+		return ret;
+	}
+
+	return platform_device_add(pdev);
+}
+
+#endif /* _GS_PLATFORM_COMPAT_H */
diff --git a/include/soc/google/gs_thermal_compat.h b/include/soc/google/gs_thermal_compat.h
new file mode 100644
index 0000000..0da9c65
--- /dev/null
+++ b/include/soc/google/gs_thermal_compat.h
@@ -0,0 +1,136 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * junkyard (lynx): index-based thermal trip accessors for the gs101/gs201-era
+ * thermal drivers, which were written against the 6.1 thermal core.
+ *
+ * Between 6.1 and 6.18 the core moved trips into struct thermal_trip_desc
+ * (tz->trips[i].trip), hung each trip's bound cooling-device instances off
+ * the descriptor (td->thermal_instances, linked by instance->trip_node), and
+ * removed thermal_zone_get_trip(), thermal_zone_get_num_trips(),
+ * __thermal_zone_get_trip() and get_thermal_instance() from the driver API.
+ *
+ * These drivers already include the core's private thermal_core.h, so the
+ * helpers below read the same fields the removed functions used to.
+ */
+#ifndef _GS_THERMAL_COMPAT_H
+#define _GS_THERMAL_COMPAT_H
+
+#include <linux/errno.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/thermal.h>
+#include <thermal_core.h>
+
+static inline int gs_thermal_zone_get_num_trips(struct thermal_zone_device *tz)
+{
+	return tz->num_trips;
+}
+
+static inline int gs_thermal_zone_get_trip(struct thermal_zone_device *tz, int trip_id,
+					   struct thermal_trip *trip)
+{
+	if (!tz || !trip || trip_id < 0 || trip_id >= tz->num_trips)
+		return -EINVAL;
+
+	*trip = tz->trips[trip_id].trip;
+	return 0;
+}
+
+/* Index of @trip within @tz, or -EINVAL if it is not one of @tz's trips. */
+static inline int gs_thermal_zone_trip_id(struct thermal_zone_device *tz,
+					  const struct thermal_trip *trip)
+{
+	int i;
+
+	for (i = 0; i < tz->num_trips; i++)
+		if (&tz->trips[i].trip == trip)
+			return i;
+	return -EINVAL;
+}
+
+/*
+ * 6.1's get_thermal_instance(): the instance binding @cdev to trip @trip_id of
+ * @tz, or NULL. Takes tz->lock and cdev->lock like the original did, so the
+ * caller must hold neither.
+ */
+static inline struct thermal_instance *
+gs_get_thermal_instance(struct thermal_zone_device *tz,
+			struct thermal_cooling_device *cdev, int trip_id)
+{
+	struct thermal_instance *pos, *target = NULL;
+
+	if (trip_id < 0 || trip_id >= tz->num_trips)
+		return NULL;
+
+	mutex_lock(&tz->lock);
+	mutex_lock(&cdev->lock);
+	list_for_each_entry(pos, &tz->trips[trip_id].thermal_instances, trip_node) {
+		if (pos->cdev == cdev) {
+			target = pos;
+			break;
+		}
+	}
+	mutex_unlock(&cdev->lock);
+	mutex_unlock(&tz->lock);
+
+	return target;
+}
+
+/*
+ * Set trip @trip_id of @tz to @temp the way 6.18's trip_point_temp_store()
+ * does: the zone's set_trip_temp() callback first, then the core's own trip
+ * update, both under the zone lock. Replaces the 6.1 pattern of calling
+ * tz->ops->set_trip_temp(tz, i, temp) and then writing tz->trips[i] by hand.
+ * The caller must not hold tz->lock.
+ */
+static inline int gs_thermal_zone_set_trip_temp(struct thermal_zone_device *tz,
+						int trip_id, int temp)
+{
+	struct thermal_trip *trip;
+	int ret = 0;
+
+	if (trip_id < 0 || trip_id >= tz->num_trips)
+		return -EINVAL;
+
+	trip = &tz->trips[trip_id].trip;
+	mutex_lock(&tz->lock);
+	if (tz->ops.set_trip_temp)
+		ret = tz->ops.set_trip_temp(tz, trip, temp);
+	if (!ret)
+		thermal_zone_set_trip_temp(tz, trip, temp);
+	mutex_unlock(&tz->lock);
+
+	return ret;
+}
+
+/*
+ * junkyard (lynx-linus-mainline): thermal_cdev_update() is exported only by the
+ * Android Common Kernels; in Linus' tree it is private to the thermal core.
+ * These drivers call it to apply a cooling device's new target at once. This
+ * is upstream's (drivers/thermal/thermal_helpers.c, v7.3) minus what a module
+ * cannot reach: the netlink state notification, the cooling_device stats in
+ * sysfs and the thermal debugfs record are not updated for these changes.
+ */
+static inline void gs_thermal_cdev_update(struct thermal_cooling_device *cdev)
+{
+	struct thermal_instance *instance;
+	unsigned long target = 0;
+
+	mutex_lock(&cdev->lock);
+	if (!cdev->updated) {
+		/* Make sure cdev enters the deepest cooling state */
+		list_for_each_entry(instance, &cdev->thermal_instances, cdev_node) {
+			if (instance->target == THERMAL_NO_TARGET)
+				continue;
+			if (instance->target > target)
+				target = instance->target;
+		}
+		if (!cdev->ops->set_cur_state(cdev, target))
+			dev_dbg(&cdev->device, "set to state %lu\n", target);
+		cdev->updated = true;
+	}
+	mutex_unlock(&cdev->lock);
+}
+#define thermal_cdev_update gs_thermal_cdev_update
+
+#endif /* _GS_THERMAL_COMPAT_H */
