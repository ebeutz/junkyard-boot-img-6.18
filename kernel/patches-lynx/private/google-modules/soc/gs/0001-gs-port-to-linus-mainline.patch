+/*
+ * junkyard (lynx-linus-mainline): thread_group_cputime_adjusted() and
+ * nsec_to_clock_t() are exported only by the Android Common Kernels. The
+ * group's CPU time is summed from the raw per-thread utime/stime plus what
+ * reaped threads left in signal_struct, without the scheduler's precise
+ * (sum_exec_runtime-scaled) adjustment; close enough for a top-N ranking.
+ * Called under rcu_read_lock() like the original.
+ */
+static void jy_thread_group_cputime_adjusted(struct task_struct *p, u64 *ut, u64 *st)
+{
+	struct signal_struct *sig = p->signal;
+	struct task_struct *t;
+	u64 utime = sig->utime, stime = sig->stime;
+
+	for_each_thread(p, t) {
+		utime += READ_ONCE(t->utime);
+		stime += READ_ONCE(t->stime);
+	}
+	*ut = utime;
+	*st = stime;
+}
+#define thread_group_cputime_adjusted jy_thread_group_cputime_adjusted
+
+static u64 jy_nsec_to_clock_t(u64 x)
+{
+	return div_u64(x, NSEC_PER_SEC / USER_HZ);
+}
+#define nsec_to_clock_t jy_nsec_to_clock_t
+#endif
