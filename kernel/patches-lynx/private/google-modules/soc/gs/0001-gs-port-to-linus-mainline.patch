diff --git a/drivers/soc/google/pixel_stat/mm/pixel_stat_task.h b/drivers/soc/google/pixel_stat/mm/pixel_stat_task.h
new file mode 100644
index 0000000..a7e5534
--- /dev/null
+++ b/drivers/soc/google/pixel_stat/mm/pixel_stat_task.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * junkyard (lynx-mainline): per-task scratch for the CMA and direct-reclaim
+ * latency stats.
+ *
+ * On the ACK GKI these timestamps lived in vh_sched's struct
+ * vendor_task_struct (android_task_vendor_data()). android-mainline has
+ * neither that accessor nor vh_sched, only task_struct's 6-slot
+ * android_vendor_data1[] (CONFIG_ANDROID_VENDOR_OEM_DATA), which nothing else
+ * the lynx build compiles uses. Two of its slots carry the timestamps.
+ */
+#ifndef _PIXEL_STAT_TASK_H
+#define _PIXEL_STAT_TASK_H
+
+#include <linux/sched.h>
+
+enum {
+	PIXEL_STAT_TASK_CMA_TS,		/* was vendor_task_struct "private" */
+	PIXEL_STAT_TASK_RECLAIM_TS,	/* was vendor_task_struct::direct_reclaim_ts */
+};
+
+/*
+ * junkyard (lynx-linus-mainline): Linus' task_struct has no vendor data at
+ * all. The users (cma.c, vmscan.c) only reach this with
+ * CONFIG_ANDROID_VENDOR_HOOKS.
+ */
+#if IS_ENABLED(CONFIG_ANDROID_VENDOR_HOOKS)
+static inline u64 *pixel_stat_task_slot(struct task_struct *p, int slot)
+{
+	return &p->android_vendor_data1[slot];
+}
+#endif
+
+#endif
