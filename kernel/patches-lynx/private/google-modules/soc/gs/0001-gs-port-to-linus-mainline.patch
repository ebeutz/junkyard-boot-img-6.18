diff --git a/include/arm-smmu-v3/pixel-iommu-fault.h b/include/arm-smmu-v3/pixel-iommu-fault.h
new file mode 100644
index 0000000..e8ced72
--- /dev/null
+++ b/include/arm-smmu-v3/pixel-iommu-fault.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * junkyard (lynx): identical copy of iommu/arm-smmu-v3/include/arm-smmu-v3/
+ * pixel-iommu-fault.h. On Laguna that package provides the API; on gs101/gs201
+ * the Samsung SysMMU driver (samsung_iommu.ko) provides the same symbols, so
+ * clients port the same way on both. Keep the two in sync.
+ */
+#ifndef _PIXEL_IOMMU_FAULT_H
+#define _PIXEL_IOMMU_FAULT_H
+
+#include <linux/types.h>
+
+struct device;
+struct iommu_domain;
+
+typedef int (*pixel_iommu_fault_handler_t)(struct device *dev, unsigned long iova,
+					 u32 pasid, int flags, void *token);
+
+/*
+ * Unrecoverable faults only. Handlers may sleep, but must not register or
+ * unregister handlers, or attach/detach IOMMU domains. The SMMU holds its
+ * attachment locks while reporting a fault.
+ *
+ * Unregister before freeing the token or unloading the handler's module.
+ * Unregister waits for active callbacks. All three operations may sleep.
+ */
+int pixel_iommu_register_fault_handler(struct device *dev,
+				       pixel_iommu_fault_handler_t handler, void *token);
+void pixel_iommu_unregister_fault_handler(struct device *dev);
+/* A fault may outlive its attachment; domain may be NULL. */
+int pixel_iommu_report_fault(struct iommu_domain *domain, struct device *dev,
+			     unsigned long iova, u32 pasid, int flags);
+
+#endif /* _PIXEL_IOMMU_FAULT_H */
diff --git a/include/linus-compat/linux/of_gpio.h b/include/linus-compat/linux/of_gpio.h
new file mode 100644
index 0000000..978a5b7
--- /dev/null
+++ b/include/linus-compat/linux/of_gpio.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * junkyard (lynx-linus-mainline): stand-in for <linux/of_gpio.h>.
+ *
+ * Linus' tree deleted the header and of_get_named_gpio() (the last in-tree
+ * users moved to gpiod); the Android Common Kernels restore both. ~150 vendor
+ * files still include it. Like <linux/wakeup_reason.h> next to it, this file
+ * is on the vendor include path, which kbuild searches after the kernel's own
+ * include/, so an ACK's real header still wins.
+ *
+ * of_get_named_gpio() returns the legacy global GPIO number for the
+ * @index'th specifier in @propname without requesting it, as before. It is
+ * rebuilt on exported API: the phandle is parsed against #gpio-cells and the
+ * controller looked up with gpio_device_find_by_fwnode(); the number is the
+ * chip's base plus the first specifier cell. That is the standard two-cell
+ * xlate, which is what the gs201 GPIO controllers (Samsung pinctrl banks,
+ * S2MPG/SLG PMIC GPIOs) use; a controller with a custom of_xlate would be
+ * mistranslated. -EPROBE_DEFER if the controller is not registered yet.
+ */
+#ifndef __LINUX_OF_GPIO_H
+#define __LINUX_OF_GPIO_H
+
+#include <linux/compiler.h>
+#include <linux/errno.h>
+#include <linux/gpio/driver.h>
+#include <linux/gpio.h>
+#include <linux/of.h>
+
+static inline int of_get_named_gpio(const struct device_node *np,
+				    const char *propname, int index)
+{
+	struct of_phandle_args args;
+	struct gpio_device *gdev;
+	struct gpio_chip *gc;
+	int ret;
+
+	ret = of_parse_phandle_with_args(np, propname, "#gpio-cells", index,
+					 &args);
+	if (ret)
+		return ret;
+
+	gdev = gpio_device_find_by_fwnode(of_fwnode_handle(args.np));
+	of_node_put(args.np);
+	if (!gdev)
+		return -EPROBE_DEFER;
+
+	gc = gpio_device_get_chip(gdev);
+	if (args.args_count < 1 || !gc || args.args[0] >= gc->ngpio)
+		ret = -EINVAL;
+	else
+		ret = gpio_device_get_base(gdev) + args.args[0];
+
+	gpio_device_put(gdev);
+	return ret;
+}
+
+#endif /* __LINUX_OF_GPIO_H */
diff --git a/include/linus-compat/linux/wakeup_reason.h b/include/linus-compat/linux/wakeup_reason.h
new file mode 100644
index 0000000..845b051
--- /dev/null
+++ b/include/linus-compat/linux/wakeup_reason.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * junkyard (lynx-linus-mainline): stand-in for the Android Common Kernel's
+ * <linux/wakeup_reason.h> (kernel/power/wakeup_reason.c, ACK only).
+ *
+ * The soc/gs PMIC interrupt drivers and exynos-pm record which interrupt woke
+ * the system through it, for Android's /sys/kernel/wakeup_reasons. Linus'
+ * tree has neither the header nor the code. This file sits on the soc/gs
+ * include path, which kbuild searches AFTER the kernel's own include/, so on
+ * an ACK the real header still wins and this one is only seen where the
+ * kernel has none. It provides the !CONFIG_SUSPEND no-op stubs of the ACK
+ * header. The wakeup IRQ is still reported by upstream's own
+ * /sys/power/pm_wakeup_irq.
+ */
+#ifndef _LINUX_WAKEUP_REASON_H
+#define _LINUX_WAKEUP_REASON_H
+
+#define MAX_SUSPEND_ABORT_LEN 256
+#define MAX_WAKEUP_REASON_IRQ_NAME_LEN 64
+
+static inline void log_irq_wakeup_reason(int irq) { }
+static inline void log_threaded_irq_wakeup_reason(int irq, int parent_irq) { }
+static inline __printf(1, 2) void log_suspend_abort_reason(const char *fmt, ...) { }
+static inline __printf(1, 2) void log_abnormal_wakeup_reason(const char *fmt, ...) { }
+static inline void clear_wakeup_reasons(void) { }
+
+#endif /* _LINUX_WAKEUP_REASON_H */
diff --git a/include/linus-compat/soc/google/kernel-tracepoint.h b/include/linus-compat/soc/google/kernel-tracepoint.h
new file mode 100644
index 0000000..b33602b
--- /dev/null
+++ b/include/linus-compat/soc/google/kernel-tracepoint.h
@@ -0,0 +1,86 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * junkyard (lynx-linus-mainline): attach a probe to a core-kernel tracepoint
+ * that is not EXPORT_TRACEPOINT_SYMBOL()ed.
+ *
+ * The Android Common Kernels export a number of core tracepoints for vendor
+ * modules (sched_switch, device_pm_callback_*, workqueue_execute_*, cma_alloc_*,
+ * mm_vmscan_direct_reclaim_*, irq_handler_entry, ...). Linus' tree does not, so
+ * register_trace_<name>() from a module fails modpost on __tracepoint_<name>.
+ * Rather than carry those exports as kernel patches, look the tracepoint up by
+ * name through the exported for_each_kernel_tracepoint() and attach with the
+ * exported tracepoint_probe_register(), the way out-of-tree tracers do.
+ *
+ * What is lost against register_trace_<name>() is the compile-time check of
+ * the probe prototype: the probe must take (void *data, <TP_PROTO args>) of the
+ * tracepoint exactly as declared in the matching include/trace/events/ header,
+ * which callers still include for their types. The JUNKYARD_TRACE_PROBE_CHECK()
+ * helper below restores that check where the header is included.
+ */
+#ifndef _SOC_GOOGLE_KERNEL_TRACEPOINT_H
+#define _SOC_GOOGLE_KERNEL_TRACEPOINT_H
+
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/tracepoint.h>
+
+struct junkyard_tp_lookup {
+	const char *name;
+	struct tracepoint *tp;
+};
+
+static inline void junkyard_tp_lookup_fn(struct tracepoint *tp, void *priv)
+{
+	struct junkyard_tp_lookup *l = priv;
+
+	if (!l->tp && !strcmp(tp->name, l->name))
+		l->tp = tp;
+}
+
+static inline struct tracepoint *junkyard_find_kernel_tracepoint(const char *name)
+{
+	struct junkyard_tp_lookup l = { .name = name };
+
+	for_each_kernel_tracepoint(junkyard_tp_lookup_fn, &l);
+	return l.tp;
+}
+
+static inline int junkyard_register_kernel_tracepoint(const char *name, void *probe,
+						      void *data)
+{
+	struct tracepoint *tp = junkyard_find_kernel_tracepoint(name);
+
+	if (!tp)
+		return -ENOENT;
+	return tracepoint_probe_register(tp, probe, data);
+}
+
+static inline int junkyard_unregister_kernel_tracepoint(const char *name, void *probe,
+							void *data)
+{
+	struct tracepoint *tp = junkyard_find_kernel_tracepoint(name);
+
+	if (!tp)
+		return -ENOENT;
+	return tracepoint_probe_unregister(tp, probe, data);
+}
+
+/*
+ * Compile-time prototype check: register_trace_<tp>() is a static inline the
+ * trace/events header defines whether or not __tracepoint_<tp> is exported;
+ * taking its address with the probe's type checked against it costs nothing
+ * at runtime and emits no reference to the unexported symbol (the function is
+ * never called).
+ */
+#define JUNKYARD_TRACE_PROBE_CHECK(tp, probe)					\
+	((void)sizeof((register_trace_##tp)(probe, NULL)))
+
+#define junkyard_register_trace(tp, probe, data)				\
+	({ JUNKYARD_TRACE_PROBE_CHECK(tp, probe);				\
+	   junkyard_register_kernel_tracepoint(#tp, (void *)(probe), (data)); })
+
+#define junkyard_unregister_trace(tp, probe, data)				\
+	({ JUNKYARD_TRACE_PROBE_CHECK(tp, probe);				\
+	   junkyard_unregister_kernel_tracepoint(#tp, (void *)(probe), (data)); })
+
+#endif /* _SOC_GOOGLE_KERNEL_TRACEPOINT_H */
diff --git a/include/linus-compat/soc/google/linus-compat.h b/include/linus-compat/soc/google/linus-compat.h
new file mode 100644
index 0000000..dc9fa30
--- /dev/null
+++ b/include/linus-compat/soc/google/linus-compat.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * junkyard (lynx-linus-mainline): compatibility for the gs201 vendor modules
+ * built against Linus' tree instead of an Android Common Kernel.
+ *
+ * Force-included (-include) by the Kbuild files of the vendor projects that
+ * need it, so it must not include anything itself: it is seen before any
+ * file's own #defines (pr_fmt, CREATE_TRACE_POINTS, ...) and before any kernel
+ * header. Only compiler builtins (__SIZE_TYPE__) are used for that reason.
+ *
+ * Everything here covers an interface UPSTREAM removed, not an ACK-only one:
+ * the ACK-only interfaces are handled at their call sites.
+ */
+#ifndef _SOC_GOOGLE_LINUS_COMPAT_H
+#define _SOC_GOOGLE_LINUS_COMPAT_H
+
+/*
+ * Only where the kernel is not an Android Common Kernel (this port's test for
+ * that is CONFIG_ANDROID_VENDOR_HOOKS; kbuild's -include of kconfig.h comes
+ * before this file on the command line, so CONFIG_* are visible here).
+ */
+#ifndef CONFIG_ANDROID_VENDOR_HOOKS
+
+/*
+ * strncpy(): removed from the kernel by 079a028d6327 ("string: Remove
+ * strncpy() from the kernel") after every in-tree caller was converted. The
+ * vendor modules were never part of that conversion. Each call site would have
+ * to choose between strscpy(), strscpy_pad(), strtomem_pad() and
+ * memcpy_and_pad() depending on whether the destination is a NUL-terminated
+ * string or a fixed-width field; rather than make those decisions blind, keep
+ * the old semantics exactly (same loop as the removed lib/string.c version:
+ * copy up to @count bytes, NUL-pad the rest, NO terminator if @src is longer).
+ * The FORTIFY_SOURCE bounds check the kernel wrapper had is not reproduced.
+ */
+static inline __attribute__((__always_inline__, __unused__))
+char *junkyard_strncpy(char *dest, const char *src, __SIZE_TYPE__ count)
+{
+	char *tmp = dest;
+
+	while (count) {
+		if ((*tmp = *src) != 0)
+			src++;
+		tmp++;
+		count--;
+	}
+	return dest;
+}
+#define strncpy(dest, src, count) junkyard_strncpy((dest), (src), (count))
+
+/*
+ * power:clock_set_rate: removed with the other power:clock_* events by
+ * de6fdc076d39 (the clk framework has its own clk:clk_set_rate events). The
+ * vendor drivers emit it as a pure trace marker for DVFS changes; nothing
+ * consumes its return or side effects, so it becomes a no-op that still
+ * evaluates its arguments.
+ */
+#define trace_clock_set_rate(name, state, cpu_id)			\
+	do {								\
+		(void)(name);						\
+		(void)(state);						\
+		(void)(cpu_id);						\
+	} while (0)
+#define trace_clock_set_rate_enabled() 0
+
+/*
+ * cpumap_print_to_pagebuf(): removed upstream (users print with "%*pb[l]"
+ * directly). Same output as the removed inline, which was
+ * bitmap_print_to_pagebuf(): bounded by the rest of @buf's page, and with a
+ * trailing newline. Expands at the call site, so needs nothing included here.
+ */
+#define cpumap_print_to_pagebuf(list, buf, mask)				\
+	scnprintf((buf), PAGE_SIZE - ((unsigned long)(buf) & (PAGE_SIZE - 1)), \
+		  (list) ? "%*pbl\n" : "%*pb\n", cpumask_pr_args(mask))
+
+#endif /* !CONFIG_ANDROID_VENDOR_HOOKS */
+
+#endif /* _SOC_GOOGLE_LINUS_COMPAT_H */
diff --git a/include/linus-compat/soc/google/perf-read-local.h b/include/linus-compat/soc/google/perf-read-local.h
new file mode 100644
index 0000000..23c8dc9
--- /dev/null
+++ b/include/linus-compat/soc/google/perf-read-local.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * junkyard (lynx-linus-mainline): perf_event_read_local() for modules.
+ *
+ * perf_event_read_local() is exported only by the Android Common Kernels; the
+ * memlat governors read their per-CPU PMU counters with it from atomic
+ * context, where the exported perf_event_read_value() (which sleeps on the
+ * context mutex) cannot be used. This is upstream's v7.3 function minus the
+ * enabled/running times (calc_timer_values() is internal): for the per-CPU,
+ * non-inherited counting events these drivers create, refresh the hardware
+ * count if the event is live on this CPU and return event->count. *enabled
+ * and *running, when asked for, are reported as 0; neither caller uses them.
+ */
+#ifndef _SOC_GOOGLE_PERF_READ_LOCAL_H
+#define _SOC_GOOGLE_PERF_READ_LOCAL_H
+
+#include <linux/irqflags.h>
+#include <linux/perf_event.h>
+#include <linux/smp.h>
+
+static inline int jy_perf_event_read_local(struct perf_event *event, u64 *value,
+					   u64 *enabled, u64 *running)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	local_irq_save(flags);
+
+	if (event->attr.inherit) {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	/* Only per-CPU events for this CPU (what the callers create). */
+	if ((event->attach_state & PERF_ATTACH_TASK) ||
+	    event->cpu != smp_processor_id()) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	if (event->attr.pinned && READ_ONCE(event->oncpu) != smp_processor_id()) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	if (READ_ONCE(event->oncpu) == smp_processor_id())
+		event->pmu->read(event);
+
+	*value = local64_read(&event->count);
+	if (enabled)
+		*enabled = 0;
+	if (running)
+		*running = 0;
+out:
+	local_irq_restore(flags);
+	return ret;
+}
+
+#endif /* _SOC_GOOGLE_PERF_READ_LOCAL_H */
diff --git a/include/linus-compat/soc/google/psy-reference-array.h b/include/linus-compat/soc/google/psy-reference-array.h
new file mode 100644
index 0000000..9994460
--- /dev/null
+++ b/include/linus-compat/soc/google/psy-reference-array.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * junkyard (lynx-linus-mainline): power_supply_get_by_reference_array() for modules (bms, bcl).
+ *
+ * An Android Common Kernel addition to drivers/power/supply/power_supply_core.c
+ * that Linus' tree does not have: follow the @property phandle of @fwnode and
+ * return every power supply whose parent device is the referenced node (a
+ * charger IC can register several). Rebuilt here on exported API only:
+ * power_supply_for_each_psy() to walk the supplies and power_supply_get_by_name()
+ * to take each reference, so the callers' power_supply_put() still balances.
+ *
+ * Returns the number of supplies stored in @psy, -EOVERFLOW if @size is too
+ * small, -EINVAL for a bad @psy/@size, -ENODEV if the reference is missing.
+ */
+#ifndef _SOC_GOOGLE_PSY_REFERENCE_ARRAY_H
+#define _SOC_GOOGLE_PSY_REFERENCE_ARRAY_H
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+
+struct jy_psy_ref_array {
+	struct fwnode_handle *parent;
+	struct power_supply **psy;
+	ssize_t size;
+	ssize_t count;
+};
+
+static inline int jy_psy_ref_array_match(struct power_supply *psy, void *data)
+{
+	struct jy_psy_ref_array *p = data;
+	struct power_supply *ref;
+
+	if (!psy->dev.parent || dev_fwnode(psy->dev.parent) != p->parent)
+		return 0;
+	if (!psy->desc || !psy->desc->name)
+		return 0;
+	if (p->count >= p->size)
+		return -EOVERFLOW;
+
+	ref = power_supply_get_by_name(psy->desc->name);
+	if (!ref)
+		return 0;
+	p->psy[p->count++] = ref;
+	return 0;
+}
+
+static inline int jy_power_supply_get_by_reference_array(struct fwnode_handle *fwnode,
+							 const char *property,
+							 struct power_supply **psy,
+							 ssize_t size)
+{
+	struct jy_psy_ref_array p = { .psy = psy, .size = size };
+	int ret;
+
+	if (!psy || !size)
+		return -EINVAL;
+
+	p.parent = fwnode_find_reference(fwnode, property, 0);
+	if (IS_ERR(p.parent))
+		return -ENODEV;
+
+	ret = power_supply_for_each_psy(&p, jy_psy_ref_array_match);
+	fwnode_handle_put(p.parent);
+	if (ret) {
+		while (p.count > 0)
+			power_supply_put(psy[--p.count]);
+		return ret;
+	}
+	return p.count;
+}
+#define power_supply_get_by_reference_array jy_power_supply_get_by_reference_array
+
+#endif /* _SOC_GOOGLE_PSY_REFERENCE_ARRAY_H */
diff --git a/include/linus-compat/soc/google/samsung-dma-heap.h b/include/linus-compat/soc/google/samsung-dma-heap.h
new file mode 100644
index 0000000..217f41f
--- /dev/null
+++ b/include/linus-compat/soc/google/samsung-dma-heap.h
@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * junkyard (lynx-linus-mainline): in-kernel allocation from the Samsung
+ * dma-buf heaps (samsung_dma_heap.ko).
+ *
+ * The Android Common Kernels export dma_heap_find(), dma_heap_buffer_alloc()
+ * and dma_heap_put() so that drivers can allocate from a heap by name without
+ * going through /dev/dma_heap. Linus' tree has no in-kernel heap API (struct
+ * dma_heap is private to drivers/dma-buf/dma-heap.c). Every heap the gs201
+ * drivers allocate from in-kernel ("system", "system-uncached",
+ * "vframe-secure", "mfc_fw-secure", ...) is one samsung_dma_heap.ko registers
+ * itself, so that module offers the same three operations over its own heaps.
+ *
+ * Heaps are never unregistered (upstream dma-heap has no removal), so the
+ * pointer from samsung_dma_heap_find() stays valid and there is no put.
+ */
+#ifndef _SOC_GOOGLE_SAMSUNG_DMA_HEAP_H
+#define _SOC_GOOGLE_SAMSUNG_DMA_HEAP_H
+
+#include <linux/types.h>
+
+struct dma_buf;
+struct samsung_dma_heap;
+
+/* Returns the heap registered under @name, or NULL. */
+struct samsung_dma_heap *samsung_dma_heap_find(const char *name);
+
+/*
+ * Allocates a dma-buf of @len (page aligned up) from @heap, as the
+ * DMA_HEAP_IOCTL_ALLOC ioctl on its /dev/dma_heap node would. Returns the
+ * dma_buf or an ERR_PTR().
+ */
+struct dma_buf *samsung_dma_heap_buffer_alloc(struct samsung_dma_heap *heap,
+					      size_t len, u32 fd_flags,
+					      u64 heap_flags);
+
+/*
+ * Per-attachment DMA mapping attributes (DMA_ATTR_PRIVILEGED,
+ * DMA_ATTR_SKIP_CPU_SYNC, DMA_ATTR_SKIP_LAZY_UNMAP, ...) that importers hand
+ * the Samsung heaps. The Android Common Kernels carry them in a
+ * dma_buf_attachment::dma_map_attrs field Linus' tree does not have; the
+ * Samsung heaps keep them in their own per-attachment data instead. The
+ * setter is a no-op for an attachment to any other exporter's buffer, whose
+ * private data it must not touch -- and which would ignore the attributes on
+ * an ACK too.
+ */
+struct dma_buf_attachment;
+unsigned long samsung_dma_buf_attach_attrs(struct dma_buf_attachment *a);
+void samsung_dma_buf_attach_set_attrs(struct dma_buf_attachment *a,
+				      unsigned long attrs);
+
+#endif /* _SOC_GOOGLE_SAMSUNG_DMA_HEAP_H */
diff --git a/include/linus-compat/soc/google/sched-setscheduler.h b/include/linus-compat/soc/google/sched-setscheduler.h
new file mode 100644
index 0000000..a56f921
--- /dev/null
+++ b/include/linus-compat/soc/google/sched-setscheduler.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * junkyard (lynx-linus-mainline): sched_setscheduler() and
+ * sched_setscheduler_nocheck() for modules.
+ *
+ * Upstream unexported both in 5.9 (modules are meant to use sched_set_fifo()
+ * and friends); the Android Common Kernels export them again. The vendor
+ * drivers use them to give their kernel threads specific SCHED_FIFO
+ * priorities, which sched_set_fifo() (fixed MAX_RT_PRIO / 2) would flatten.
+ * sched_setattr_nocheck() is exported, so build the same struct sched_attr
+ * that kernel/sched/syscalls.c:_sched_setscheduler() does and use it.
+ *
+ * Both names map to the unchecked variant: every caller here is a driver
+ * adjusting its own kernel thread, where the permission check against
+ * current's credentials is not meaningful.
+ */
+#ifndef _SOC_GOOGLE_SCHED_SETSCHEDULER_H
+#define _SOC_GOOGLE_SCHED_SETSCHEDULER_H
+
+#include <linux/sched.h>
+#include <linux/sched/prio.h>
+#include <uapi/linux/sched.h>
+#include <uapi/linux/sched/types.h>
+
+static inline int jy_sched_setscheduler_nocheck(struct task_struct *p, int policy,
+						const struct sched_param *param)
+{
+	struct sched_attr attr = {
+		.size		= sizeof(attr),
+		.sched_policy	= policy,
+		.sched_priority	= param->sched_priority,
+		.sched_nice	= PRIO_TO_NICE(p->static_prio),
+	};
+
+	/* Fixup the legacy SCHED_RESET_ON_FORK hack. */
+	if (policy & SCHED_RESET_ON_FORK) {
+		attr.sched_flags |= SCHED_FLAG_RESET_ON_FORK;
+		attr.sched_policy = policy & ~SCHED_RESET_ON_FORK;
+	}
+
+	return sched_setattr_nocheck(p, &attr);
+}
+
+#define sched_setscheduler(p, policy, param) \
+	jy_sched_setscheduler_nocheck((p), (policy), (param))
+#define sched_setscheduler_nocheck(p, policy, param) \
+	jy_sched_setscheduler_nocheck((p), (policy), (param))
+
+#endif /* _SOC_GOOGLE_SCHED_SETSCHEDULER_H */
