diff --git a/drivers/media/platform/exynos/mfc/mfc_ctrl_compat.h b/drivers/media/platform/exynos/mfc/mfc_ctrl_compat.h
new file mode 100644
index 0000000..22de833
--- /dev/null
+++ b/drivers/media/platform/exynos/mfc/mfc_ctrl_compat.h
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * junkyard (lynx): 6.18 removed v4l2_ioctl_ops.vidioc_{queryctrl,g_ctrl,s_ctrl}.
+ * The core now answers VIDIOC_QUERYCTRL through vidioc_query_ext_ctrl and turns
+ * VIDIOC_G_CTRL/S_CTRL into single-control g/s_ext_ctrls calls whose ->which is
+ * the control's class (v4l_g_ctrl()/v4l_s_ctrl() in v4l2-ioctl.c).
+ *
+ * MFC predates its own ext-ctrls handlers covering everything: those accept only
+ * V4L2_CTRL_CLASS_CODEC, and the decoder has no s_ext_ctrls at all. These
+ * adapters keep the 6.1 behaviour: codec-class requests go to the driver's ext
+ * handler as before, anything else is fed control-by-control to the legacy
+ * per-control handler that G_CTRL/S_CTRL used to reach.
+ */
+#ifndef _MFC_CTRL_COMPAT_H
+#define _MFC_CTRL_COMPAT_H
+
+#include <linux/string.h>
+#include <linux/videodev2.h>
+
+typedef int (*mfc_compat_one_ctrl_t)(struct file *file, void *priv, struct v4l2_control *ctrl);
+typedef int (*mfc_compat_ext_ctrls_t)(struct file *file, void *priv, struct v4l2_ext_controls *f);
+typedef int (*mfc_compat_queryctrl_t)(struct file *file, void *priv, struct v4l2_queryctrl *qc);
+
+static inline int mfc_compat_query_ext_ctrl(struct file *file, void *priv,
+					    struct v4l2_query_ext_ctrl *qec,
+					    mfc_compat_queryctrl_t queryctrl)
+{
+	struct v4l2_queryctrl qc = { .id = qec->id };
+	int ret;
+
+	ret = queryctrl(file, priv, &qc);
+	if (ret)
+		return ret;
+
+	memset(qec, 0, sizeof(*qec));
+	qec->id = qc.id;
+	qec->type = qc.type;
+	strscpy(qec->name, qc.name, sizeof(qec->name));
+	qec->minimum = qc.minimum;
+	qec->maximum = qc.maximum;
+	qec->step = qc.step;
+	qec->default_value = qc.default_value;
+	qec->flags = qc.flags;
+	qec->elem_size = sizeof(s32);
+	qec->elems = 1;
+	return 0;
+}
+
+static inline int mfc_compat_ext_ctrls(struct file *file, void *priv,
+				       struct v4l2_ext_controls *f,
+				       mfc_compat_ext_ctrls_t codec_ext,
+				       mfc_compat_one_ctrl_t one)
+{
+	unsigned int i;
+	int ret;
+
+	if (codec_ext && f->which == V4L2_CTRL_CLASS_CODEC)
+		return codec_ext(file, priv, f);
+
+	for (i = 0; i < f->count; i++) {
+		struct v4l2_control ctrl = {
+			.id = f->controls[i].id,
+			.value = f->controls[i].value,
+		};
+
+		ret = one(file, priv, &ctrl);
+		if (ret) {
+			f->error_idx = i;
+			return ret;
+		}
+		f->controls[i].value = ctrl.value;
+	}
+
+	return 0;
+}
+
+#endif /* _MFC_CTRL_COMPAT_H */
