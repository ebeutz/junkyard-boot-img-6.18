 KCFLAGS += -I$(ROOT_DIR)/private/google-modules/soc/gs/include/uapi
+# junkyard (lynx-linus-mainline): headers standing in for ACK-only kernel
+# headers and interfaces (see the linus_compat_headers target in BUILD.bazel).
+# Last, so a kernel's own copy of any of them wins.
+KCFLAGS += -I$(ROOT_DIR)/private/google-modules/soc/gs/include/linus-compat
 
 ifneq ($(wildcard $(COMMON_OUT_DIR)/private/google-modules/soc/gs/Module.symvers),)
 EXTRA_SYMBOLS += $(COMMON_OUT_DIR)/private/google-modules/soc/gs/Module.symvers
