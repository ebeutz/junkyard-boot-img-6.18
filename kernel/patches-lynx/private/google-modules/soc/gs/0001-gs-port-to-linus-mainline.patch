diff --git a/drivers/iommu/samsung-iommu-pixel-fault.c b/drivers/iommu/samsung-iommu-pixel-fault.c
new file mode 100644
index 0000000..c0789c8
--- /dev/null
+++ b/drivers/iommu/samsung-iommu-pixel-fault.c
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * junkyard (lynx): per-device unrecoverable IOMMU fault callbacks for the Samsung
+ * SysMMU, built into samsung_iommu.ko.
+ *
+ * 6.8 removed iommu_register_device_fault_handler() and unrecoverable fault
+ * events, which is how SysMMU clients (display, GXP, EdgeTPU, MFC, SMFC, G2D,
+ * BigO, LWIS) used to learn about faults. On Laguna, Google replaced it with
+ * pixel_iommu_{register,unregister}_fault_handler() / pixel_iommu_report_fault()
+ * in iommu/arm-smmu-v3/drivers/iommu/pixel-iommu-fault.c; this is that file,
+ * unchanged apart from this header, so gs201 clients use the same API.
+ */
+#include <linux/device.h>
+#include <linux/iommu.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/rwsem.h>
+#include <linux/slab.h>
+#include <arm-smmu-v3/pixel-iommu-fault.h>
+
+struct pixel_iommu_fault_handler {
+	struct list_head node;
+	struct device *dev;
+	pixel_iommu_fault_handler_t handler;
+	void *token;
+};
+
+static LIST_HEAD(fault_handlers);
+static DECLARE_RWSEM(fault_handlers_lock);
+
+int pixel_iommu_register_fault_handler(struct device *dev,
+				       pixel_iommu_fault_handler_t handler, void *token)
+{
+	struct pixel_iommu_fault_handler *entry, *other;
+	int ret = 0;
+
+	if (!dev || !handler)
+		return -EINVAL;
+
+	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (!entry)
+		return -ENOMEM;
+
+	down_write(&fault_handlers_lock);
+	list_for_each_entry(other, &fault_handlers, node) {
+		if (other->dev == dev) {
+			ret = -EBUSY;
+			goto out_unlock;
+		}
+	}
+	entry->dev = get_device(dev);
+	entry->handler = handler;
+	entry->token = token;
+	list_add_tail(&entry->node, &fault_handlers);
+out_unlock:
+	up_write(&fault_handlers_lock);
