+
+void pixel_iommu_unregister_fault_handler(struct device *dev)
+{
+	struct pixel_iommu_fault_handler *entry;
+
+	down_write(&fault_handlers_lock);
+	list_for_each_entry(entry, &fault_handlers, node) {
+		if (entry->dev == dev) {
+			list_del(&entry->node);
+			up_write(&fault_handlers_lock);
+			put_device(entry->dev);
+			kfree(entry);
+			return;
+		}
+	}
+	up_write(&fault_handlers_lock);
+}
+EXPORT_SYMBOL_GPL(pixel_iommu_unregister_fault_handler);
+
+int pixel_iommu_report_fault(struct iommu_domain *domain, struct device *dev,
+			     unsigned long iova, u32 pasid, int flags)
+{
+	struct pixel_iommu_fault_handler *entry;
+	int ret = -ENOSYS;
+
+	/* Keep the core tracepoint and any handler when the domain is still known. */
+	if (domain) {
+		ret = report_iommu_fault(domain, dev, iova, flags);
+		if (ret != -ENOSYS)
+			return ret;
+	}
+
+	down_read(&fault_handlers_lock);
+	list_for_each_entry(entry, &fault_handlers, node) {
+		if (entry->dev == dev) {
+			ret = entry->handler(dev, iova, pasid, flags, entry->token);
+			break;
+		}
+	}
+	up_read(&fault_handlers_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(pixel_iommu_report_fault);
