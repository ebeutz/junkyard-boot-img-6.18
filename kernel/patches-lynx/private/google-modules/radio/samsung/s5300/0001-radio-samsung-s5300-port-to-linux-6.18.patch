 {
-	struct mem_link_device *mld = from_timer(mld, t, crash_ack_timer);
+	struct mem_link_device *mld = timer_container_of(mld, t, crash_ack_timer);
 	struct link_device *ld = &mld->link_dev;
 	struct modem_ctl *mc = ld->mc;
 
