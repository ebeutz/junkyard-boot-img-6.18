+/*
+ * 6.13 folded page_frag_cache.va into .encoded_page (address | flags | order);
+ * the page's virtual address is the PAGE_MASK part, as mm/'s private
+ * encoded_page_decode_virt() computes it. NULL when nothing is cached.
+ */
+static inline void *cpif_pf_cache_va(const struct page_frag_cache *nc)
+{
+	return (void *)(nc->encoded_page & PAGE_MASK);
+}
