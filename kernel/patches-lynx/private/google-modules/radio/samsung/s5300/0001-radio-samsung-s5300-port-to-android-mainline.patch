-		__page_frag_cache_drain(virt_to_page(ioc->pf_cache.va),
-					ioc->pf_cache.pagecnt_bias);
-		ioc->pf_cache.va = NULL;
+		page_frag_cache_drain(&ioc->pf_cache);
 	}
 
 	return addr_asc;
