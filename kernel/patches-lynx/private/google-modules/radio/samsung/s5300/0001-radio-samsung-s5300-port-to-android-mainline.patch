-	addr_asc = ioc->pf_cache.va + ioc->pf_offset;
+	addr_asc = cpif_pf_cache_va(&ioc->pf_cache) + ioc->pf_offset;
 
 	ioc->pf_buf[idx] = addr_asc;
 	ioc->pf_offset += pf_size;
@@ -183,9 +190,7 @@ set_map:
