+	ret = iommu_attach_device_pasid(domain->domain, pool->dev, pasid, NULL); /* 6.11: attach handle */
 	if (ret) {
 		ida_free(&pool->pasid_pool, pasid);
 		return ret;
@@ -1331,4 +1331,4 @@ void gcip_iommu_unmap(struct gcip_iommu_domain *domain, dma_addr_t iova, size_t
 			 size, unmapped);
 }
 
-MODULE_IMPORT_NS(DMA_BUF);
