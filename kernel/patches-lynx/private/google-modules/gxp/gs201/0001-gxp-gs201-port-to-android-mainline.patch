From: junkyard
Subject: [PATCH] gxp/gs201: port to android-mainline

One cumulative patch, kept in two sections: the 6.1 -> 6.18 port this
project first needed for GrapheneOS's 6.18 GKI, then 6.18 -> android-mainline.

== 6.1 -> 6.18 ==
(gxp/gs201: port to Linux 6.18 (lynx))

Port private/google-modules/gxp/gs201 to the GrapheneOS Linux 6.18 GKI for the gs201 lynx build.
API migrations. Mostly mechanical; entries that change behaviour say so:

  - MODULE_IMPORT_NS() takes a string literal (6.13)
  - platform_driver.remove_new folded into .remove (6.13)
  - iommu_paging_domain_alloc(dev) (6.11); iommu_attach_device_pasid() attach handle (6.11)
  - eventfd_signal() takes only the ctx and returns void (6.8)
  - IOMMU fault reporting moved to the pixel_iommu registry samsung_iommu.ko
    exports; page-request faults are no longer reported to this driver
  - sscd: driver_override applied at registration (6.18, gs_platform_compat.h)

Files: amalthea-platform.c, gcip-kernel-driver/drivers/gcip/gcip-domain-pool.c, gcip-kernel-driver/drivers/gcip/gcip-iommu.c, gcip-kernel-driver/drivers/gcip/gcip-telemetry.c, gcip-kernel-driver/drivers/gcip/iif/iif-signaler-submission-waiter.c, gxp-common-platform.c, gxp-core-telemetry.c, gxp-dma-iommu.c, gxp-dmabuf.c, gxp-eventfd.c

lynx-only (kernel/patches-lynx/): felix builds the 6.1 tree these
drivers were written for.

== 6.18 -> android-mainline ==

Linux 6.18 -> android-mainline (7.3):

  * dma_fence::lock -> dma_fence_{lock_irqsave,unlock_irqrestore}().
  * thermal_of_cooling_device_register() gained a cdev_id argument (0).
---
diff --git a/amalthea-platform.c b/amalthea-platform.c
index e37774d..09630c3 100644
--- a/amalthea-platform.c
+++ b/amalthea-platform.c
@@ -45,7 +45,7 @@ MODULE_DEVICE_TABLE(of, gxp_of_match);
 
 static struct platform_driver gxp_platform_driver = {
 	.probe = gxp_platform_probe,
-	.remove_new = gxp_common_platform_remove,
+	.remove = gxp_common_platform_remove, /* 6.13: .remove_new folded into .remove */
 	.driver = {
 			.name = GXP_DRIVER_NAME,
 			.of_match_table = of_match_ptr(gxp_of_match),
diff --git a/gcip-kernel-driver/drivers/gcip/gcip-dma-fence.c b/gcip-kernel-driver/drivers/gcip/gcip-dma-fence.c
index ef80a3f..5ec0dee 100644
--- a/gcip-kernel-driver/drivers/gcip/gcip-dma-fence.c
+++ b/gcip-kernel-driver/drivers/gcip/gcip-dma-fence.c
@@ -44,15 +44,16 @@ int gcip_signal_dma_fence_with_status(struct dma_fence *fence, int error, bool i
 	 * This loop will be executed exactly once for cur == @fence, if @fence is not an array.
 	 */
 	dma_fence_unwrap_for_each(cur, &iter, fence) {
-		spin_lock_irqsave(cur->lock, flags);
+		dma_fence_lock_irqsave(cur, flags);
 		/* don't signal fence twice */
 		if (unlikely(test_bit(DMA_FENCE_FLAG_SIGNALED_BIT, &cur->flags)))
 			goto cont_unlock;
 		if (error)
 			dma_fence_set_error(cur, error);
-		ret = dma_fence_signal_locked(cur);
+		dma_fence_signal_locked(cur);	/* returns void on android-mainline */
+		ret = 0;
 cont_unlock:
-		spin_unlock_irqrestore(cur->lock, flags);
+		dma_fence_unlock_irqrestore(cur, flags);
 	}
 
 	return ret;
@@ -290,7 +291,7 @@ void gcip_dma_fence_array_disable_signaling(struct dma_fence *fence)
 	if (!dma_fence_is_array(fence))
 		return;
 
-	spin_lock_irqsave(fence->lock, flags);
+	dma_fence_lock_irqsave(fence, flags);
 
 	if (!test_bit(DMA_FENCE_FLAG_ENABLE_SIGNAL_BIT, &fence->flags))
 		goto out;
@@ -303,5 +304,5 @@ void gcip_dma_fence_array_disable_signaling(struct dma_fence *fence)
 	clear_bit(DMA_FENCE_FLAG_ENABLE_SIGNAL_BIT, &fence->flags);
 
 out:
-	spin_unlock_irqrestore(fence->lock, flags);
+	dma_fence_unlock_irqrestore(fence, flags);
 }
diff --git a/gcip-kernel-driver/drivers/gcip/gcip-domain-pool.c b/gcip-kernel-driver/drivers/gcip/gcip-domain-pool.c
index 882aa80..24047e5 100644
--- a/gcip-kernel-driver/drivers/gcip/gcip-domain-pool.c
+++ b/gcip-kernel-driver/drivers/gcip/gcip-domain-pool.c
@@ -39,8 +39,9 @@ int gcip_domain_pool_init(struct device *dev, struct gcip_domain_pool *pool, uns
 		return -ENOMEM;
 	}
 	for (i = 0; i < size; i++) {
-		domain = iommu_domain_alloc(dev->bus);
-		if (!domain) {
+		/* 6.11: iommu_domain_alloc(bus) -> iommu_paging_domain_alloc(dev), ERR_PTR */
+		domain = iommu_paging_domain_alloc(dev);
+		if (IS_ERR(domain)) {
 			dev_err(pool->dev, "Failed to allocate iommu domain %d of %u\n", i + 1,
 				size);
 			gcip_domain_pool_destroy(pool);
@@ -62,8 +63,8 @@ struct iommu_domain *gcip_domain_pool_alloc(struct gcip_domain_pool *pool)
 		if (!ddomain)
 			return NULL;
 
-		ddomain->domain = iommu_domain_alloc(pool->dev->bus);
-		if (!ddomain->domain) {
+		ddomain->domain = iommu_paging_domain_alloc(pool->dev);
+		if (IS_ERR(ddomain->domain)) {
 			vfree(ddomain);
 			return NULL;
 		}
