+  -I$(ROOT_DIR)/private/google-modules/soc/gs/drivers/dma-buf/heaps \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/drivers/soc/google/vh/include \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/drivers/usb/host \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/drivers/usb/typec/tcpm/google \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/include \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/include/uapi \
+  -I$(ROOT_DIR)/private/google-modules/soc/gs/include/linus-compat
