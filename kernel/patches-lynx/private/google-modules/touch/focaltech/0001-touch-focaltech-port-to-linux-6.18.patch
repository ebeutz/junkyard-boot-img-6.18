From: junkyard
Subject: [PATCH] touch/focaltech: port to Linux 6.18 (lynx)

Port private/google-modules/touch/focaltech to the GrapheneOS Linux 6.18 GKI for the gs201 lynx build.
Mechanical API migrations, no intended behaviour change:

  - strlcpy() removed, use strscpy() (6.8)
  - relax -Wmissing-prototypes (on by default since 6.8, fatal with CONFIG_WERROR) for this vendor code

Files: ft3658/BUILD.bazel, ft3658/focaltech_core.c, ft3658/focaltech_test/focaltech_test.c

lynx-only (kernel/patches-lynx/): felix builds the 6.1 tree these
drivers were written for.
---
diff --git a/ft3658/BUILD.bazel b/ft3658/BUILD.bazel
index 7e9c65f..6f32a8d 100644
--- a/ft3658/BUILD.bazel
+++ b/ft3658/BUILD.bazel
@@ -20,6 +20,8 @@ ddk_module(
         "focaltech_test/focaltech_test_ini.c",
         "focaltech_test/supported_ic/focaltech_test_ft3658u.c",
     ],
+    # junkyard (lynx, 6.18): vendor code predating default -Wmissing-prototypes (6.8)
+    copts = ["-Wno-error=missing-prototypes"],
     out = "focal_touch.ko",
     defconfig = "defconfig",
     kconfig = "Kconfig",
diff --git a/ft3658/focaltech_core.c b/ft3658/focaltech_core.c
index a30a392..171c1d0 100644
--- a/ft3658/focaltech_core.c
+++ b/ft3658/focaltech_core.c
@@ -1111,7 +1111,7 @@ int fts_ts_set_bus_ref(struct fts_ts_data *ts, u16 ref, bool enable)
     return result;
 }
 
-struct drm_connector *get_bridge_connector(struct drm_bridge *bridge)
+static struct drm_connector *get_bridge_connector(struct drm_bridge *bridge)
 {
     struct drm_connector *connector;
     struct drm_connector_list_iter conn_iter;
diff --git a/ft3658/focaltech_test/focaltech_test.c b/ft3658/focaltech_test/focaltech_test.c
index 92d8911..59af01b 100644
--- a/ft3658/focaltech_test/focaltech_test.c
+++ b/ft3658/focaltech_test/focaltech_test.c
@@ -1527,7 +1527,7 @@ void fts_test_save_data(char *name, int code, int *data, int datacnt,
         return ;
     }
 
-    strlcpy(info->name, name, TEST_ITEM_NAME_MAX - 1);
+    strscpy(info->name, name, TEST_ITEM_NAME_MAX - 1);
     info->code = code;
     info->mc_sc = mc_sc;
     info->key_support = key;
