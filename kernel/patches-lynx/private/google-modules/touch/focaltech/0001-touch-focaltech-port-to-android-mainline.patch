From: junkyard
Subject: [PATCH] touch/focaltech: port to android-mainline

One cumulative patch, kept in two sections: the 6.1 -> 6.18 port this
project first needed for GrapheneOS's 6.18 GKI, then 6.18 -> android-mainline.

== 6.1 -> 6.18 ==
(touch/focaltech: port to Linux 6.18 (lynx))

Port private/google-modules/touch/focaltech to the GrapheneOS Linux 6.18 GKI for the gs201 lynx build.
Mechanical API migrations, no intended behaviour change:

  - strlcpy() removed, use strscpy() (6.8)
  - relax -Wmissing-prototypes (on by default since 6.8, fatal with CONFIG_WERROR) for this vendor code

Files: ft3658/BUILD.bazel, ft3658/focaltech_core.c, ft3658/focaltech_test/focaltech_test.c

lynx-only (kernel/patches-lynx/): felix builds the 6.1 tree these
drivers were written for.

== 6.18 -> android-mainline ==

Linux 6.18 -> android-mainline (7.3):

  * drm_bridge_funcs lost the non-atomic .enable/.disable. The panel bridge
    uses .atomic_enable/.atomic_disable (same bodies; they get the commit
    and ignore it) plus the bridge-state helpers the atomic hooks require.
---
diff --git a/ft3658/BUILD.bazel b/ft3658/BUILD.bazel
index 7e9c65f..6f32a8d 100644
--- a/ft3658/BUILD.bazel
+++ b/ft3658/BUILD.bazel
@@ -20,6 +20,8 @@ ddk_module(
         "focaltech_test/focaltech_test_ini.c",
         "focaltech_test/supported_ic/focaltech_test_ft3658u.c",
     ],
+    # junkyard (lynx, 6.18): vendor code predating default -Wmissing-prototypes (6.8)
+    copts = ["-Wno-error=missing-prototypes"],
     out = "focal_touch.ko",
     defconfig = "defconfig",
     kconfig = "Kconfig",
diff --git a/ft3658/focaltech_core.c b/ft3658/focaltech_core.c
index a30a392..87be898 100644
--- a/ft3658/focaltech_core.c
+++ b/ft3658/focaltech_core.c
@@ -31,6 +31,7 @@
 /*****************************************************************************
 * Included header files
 *****************************************************************************/
+#include <drm/drm_atomic_state_helper.h>
 #include <linux/module.h>
 #include <linux/init.h>
 #include <linux/of.h>
@@ -1111,7 +1112,7 @@ int fts_ts_set_bus_ref(struct fts_ts_data *ts, u16 ref, bool enable)
     return result;
 }
 
-struct drm_connector *get_bridge_connector(struct drm_bridge *bridge)
+static struct drm_connector *get_bridge_connector(struct drm_bridge *bridge)
 {
     struct drm_connector *connector;
     struct drm_connector_list_iter conn_iter;
@@ -1135,7 +1136,8 @@ static bool bridge_is_lp_mode(struct drm_connector *connector)
     return false;
 }
 
-static void panel_bridge_enable(struct drm_bridge *bridge)
+static void panel_bridge_enable(struct drm_bridge *bridge,
+		struct drm_atomic_commit *state)
 {
     struct fts_ts_data *ts =
         container_of(bridge, struct fts_ts_data, panel_bridge);
@@ -1144,7 +1146,8 @@ static void panel_bridge_enable(struct drm_bridge *bridge)
         fts_ts_set_bus_ref(ts, FTS_TS_BUS_REF_SCREEN_ON, true);
 }
 
-static void panel_bridge_disable(struct drm_bridge *bridge)
+static void panel_bridge_disable(struct drm_bridge *bridge,
+		struct drm_atomic_commit *state)
 {
     struct fts_ts_data *ts =
         container_of(bridge, struct fts_ts_data, panel_bridge);
@@ -1184,8 +1187,12 @@ static void panel_bridge_mode_set(struct drm_bridge *bridge,
 }
 
 static const struct drm_bridge_funcs panel_bridge_funcs = {
-    .enable = panel_bridge_enable,
-    .disable = panel_bridge_disable,
+    /* android-mainline: non-atomic .enable/.disable are gone */
+    .atomic_create_state = drm_atomic_helper_bridge_create_state,
+    .atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
+    .atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
+    .atomic_enable = panel_bridge_enable,
+    .atomic_disable = panel_bridge_disable,
     .mode_set = panel_bridge_mode_set,
 };
 
diff --git a/ft3658/focaltech_test/focaltech_test.c b/ft3658/focaltech_test/focaltech_test.c
index 92d8911..59af01b 100644
--- a/ft3658/focaltech_test/focaltech_test.c
+++ b/ft3658/focaltech_test/focaltech_test.c
@@ -1527,7 +1527,7 @@ void fts_test_save_data(char *name, int code, int *data, int datacnt,
         return ;
     }
 
-    strlcpy(info->name, name, TEST_ITEM_NAME_MAX - 1);
+    strscpy(info->name, name, TEST_ITEM_NAME_MAX - 1);
     info->code = code;
     info->mc_sc = mc_sc;
     info->key_support = key;
