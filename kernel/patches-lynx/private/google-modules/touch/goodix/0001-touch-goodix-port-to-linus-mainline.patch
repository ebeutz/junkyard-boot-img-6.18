+goodix_brl_touch-y += goodix_ts_tools.o
+goodix_brl_touch-y += goodix_ts_utils.o
+goodix_brl_touch-y += touch_apis.o
+goodix_brl_touch-y += touch_mf_mode.o
+LINUXINCLUDE := \
+  -I$(ROOT_DIR)/common/arch/arm64/include \
+  -I$(ROOT_DIR)/common/arch/arm64/include/uapi \
+  -I$(ROOT_DIR)/common/drivers/dma \
