diff --git a/goodix_ts_core.c b/goodix_ts_core.c
index 33637fb..28ad3ef 100644
--- a/goodix_ts_core.c
+++ b/goodix_ts_core.c
@@ -21,6 +21,8 @@
 #include <linux/uaccess.h>
 #include <linux/version.h>
 #include <drm/drm_panel.h>
+/* junkyard (lynx-linus-mainline): strncpy(), removed from Linus' tree. */
+#include <soc/google/linus-compat.h>
 
 #if LINUX_VERSION_CODE > KERNEL_VERSION(2, 6, 38)
 #include <linux/input/mt.h>
@@ -473,10 +475,19 @@ static ssize_t goodix_ts_irq_info_show(
 	if (r < 0)
 		return -EINVAL;
 
-	desc = irq_to_desc(core_data->irq);
 	offset += r;
+	/*
+	 * junkyard (lynx-linus-mainline): irq_to_desc() is exported only by the
+	 * Android Common Kernels; the disable depth is not reachable otherwise.
+	 */
+#if IS_ENABLED(CONFIG_ANDROID_VENDOR_HOOKS)
+	desc = irq_to_desc(core_data->irq);
 	r = snprintf(&buf[offset], PAGE_SIZE - offset, "disable-depth:%d\n",
 		desc->depth);
+#else
+	(void)desc;
+	r = snprintf(&buf[offset], PAGE_SIZE - offset, "disable-depth:n/a\n");
+#endif
 	if (r < 0)
 		return -EINVAL;
 
@@ -2589,7 +2600,7 @@ static int goodix_ts_resume(struct goodix_ts_core *core_data)
 	return 0;
 }
 
-#if IS_ENABLED(CONFIG_FB)
+#if GOODIX_FB_NOTIFIER
 /**
  * goodix_ts_fb_notifier_callback - Framebuffer notifier callback
  * Called by kernel during framebuffer blanck/unblank phrase
@@ -2617,7 +2628,7 @@ static int goodix_ts_fb_notifier_callback(
 #endif
 
 #if IS_ENABLED(CONFIG_PM)
-#if !IS_ENABLED(CONFIG_FB) && !IS_ENABLED(CONFIG_HAS_EARLYSUSPEND)
+#if !GOODIX_FB_NOTIFIER && !IS_ENABLED(CONFIG_HAS_EARLYSUSPEND)
 /**
  * goodix_ts_pm_suspend - PM suspend function
  * Called by kernel during system suspend phrase
@@ -2675,7 +2686,7 @@ static int goodix_ts_stage2_init(struct goodix_ts_core *cd)
 		mutex_init(&cd->ble_data.lock);
 	}
 
-#if IS_ENABLED(CONFIG_FB)
+#if GOODIX_FB_NOTIFIER
 	cd->fb_notifier.notifier_call = goodix_ts_fb_notifier_callback;
 	if (fb_register_client(&cd->fb_notifier))
 		ts_err("Failed to register fb notifier client:%d", ret);
@@ -2883,7 +2894,7 @@ err_alloc_workqueue:
 err_init_apis:
 	goodix_ts_sysfs_exit(cd);
 err_init_sysfs:
-#if IS_ENABLED(CONFIG_FB)
+#if GOODIX_FB_NOTIFIER
 	fb_unregister_client(&cd->fb_notifier);
 #endif
 	goodix_ts_pen_dev_remove(cd);
@@ -3137,7 +3148,7 @@ err_out:
 	return ret;
 }
 
-static int goodix_ts_remove(struct platform_device *pdev)
+static void goodix_ts_remove(struct platform_device *pdev)
 {
 	struct goodix_ts_core *core_data = platform_get_drvdata(pdev);
 	struct goodix_ts_hw_ops *hw_ops = core_data->hw_ops;
@@ -3167,7 +3178,7 @@ static int goodix_ts_remove(struct platform_device *pdev)
 		touch_apis_deinit(&core_data->pdev->dev);
 #endif
 		goodix_ts_sysfs_exit(core_data);
-#if IS_ENABLED(CONFIG_FB)
+#if GOODIX_FB_NOTIFIER
 		fb_unregister_client(&core_data->fb_notifier);
 #endif
 		goodix_ts_pen_dev_remove(core_data);
@@ -3183,8 +3194,6 @@ static int goodix_ts_remove(struct platform_device *pdev)
 	goodix_set_pinctrl_state(core_data, PINCTRL_MODE_SUSPEND);
 	mutex_destroy(&core_data->gesture_data_lock);
 	mutex_destroy(&core_data->cmd_lock);
-
-	return 0;
 }
 
 #if IS_ENABLED(CONFIG_PM)
@@ -3204,7 +3213,7 @@ static struct platform_driver goodix_ts_driver = {
 		.name = GOODIX_CORE_DRIVER_NAME,
 		.owner = THIS_MODULE,
 #if IS_ENABLED(CONFIG_PM)
-#if !IS_ENABLED(CONFIG_FB) && !IS_ENABLED(CONFIG_HAS_EARLYSUSPEND) &&          \
+#if !GOODIX_FB_NOTIFIER && !IS_ENABLED(CONFIG_HAS_EARLYSUSPEND) &&          \
