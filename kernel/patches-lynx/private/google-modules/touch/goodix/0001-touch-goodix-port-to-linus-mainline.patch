diff --git a/goodix_ts_core.h b/goodix_ts_core.h
index 5a25249..fcd0403 100644
--- a/goodix_ts_core.h
+++ b/goodix_ts_core.h
@@ -21,7 +21,7 @@
 #include <linux/init.h>
 #include <linux/firmware.h>
 #include <linux/slab.h>
-#include <asm/unaligned.h>
+#include <linux/unaligned.h>
 #include <linux/vmalloc.h>
 #include <linux/kthread.h>
 #include <linux/delay.h>
@@ -38,9 +38,18 @@
 #include <linux/of_gpio.h>
 #include <linux/regulator/consumer.h>
 #endif
-#if IS_ENABLED(CONFIG_FB)
+/*
+ * junkyard: CONFIG_FB used to mean "suspend on the fbdev blank notifier". The
+ * notifier's blank events (FB_EVENT_BLANK) are gone upstream, and fbdev is now
+ * there only for fbcon, so use that path only on a kernel that still has the
+ * events, and the PM ops otherwise.
+ */
 #include <linux/fb.h>
 #include <linux/notifier.h>
+#if IS_ENABLED(CONFIG_FB) && defined(FB_EVENT_BLANK)
+#define GOODIX_FB_NOTIFIER 1
+#else
+#define GOODIX_FB_NOTIFIER 0
 #endif
 #include "touch_apis.h"
 #if IS_ENABLED(CONFIG_TOUCHSCREEN_MOTION_FILTER)
@@ -935,7 +944,7 @@ struct goodix_ts_core {
 
 	struct goodix_ts_esd ts_esd;
 
-#if IS_ENABLED(CONFIG_FB)
+#if GOODIX_FB_NOTIFIER
 	struct notifier_block fb_notifier;
 #endif
 
