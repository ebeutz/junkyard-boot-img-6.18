diff --git a/qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c b/qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c
index 83f8e8b..20bfb1c 100644
--- a/qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c
+++ b/qca-wifi-host-cmn/qdf/linux/src/qdf_threads.c
@@ -22,6 +22,7 @@
  */
 
 /* Include Files */
+#include <linux/slab.h>
 #include <qdf_threads.h>
 #include <qdf_types.h>
 #include <qdf_trace.h>
@@ -146,14 +147,44 @@ qdf_export_symbol(qdf_create_thread);
 
 static uint16_t qdf_thread_id;
 
+/*
+ * junkyard (lynx): kthread_create() wants int (*)(void *), qdf_thread_func is
+ * QDF_STATUS (*)(void *). The old cast trips -Wcast-function-type-strict, and
+ * under the GKI's kCFI the indirect call through the mismatched type would
+ * trap at runtime, so call the qdf function from a correctly typed trampoline.
+ * The trampoline frees its argument; if the thread is stopped before it ever
+ * runs, kthread() never calls it and the small allocation is leaked.
+ */
+struct qdf_thread_tramp {
+	qdf_thread_func callback;
+	void *context;
+};
+
+static int qdf_thread_trampoline(void *arg)
+{
+	struct qdf_thread_tramp tramp = *(struct qdf_thread_tramp *)arg;
+
+	kfree(arg);
+	return (int)tramp.callback(tramp.context);
+}
+
 qdf_thread_t *qdf_thread_run(qdf_thread_func callback, void *context)
 {
 	struct task_struct *thread;
+	struct qdf_thread_tramp *tramp;
 
-	thread = kthread_create((qdf_thread_os_func)callback, context,
+	tramp = kmalloc(sizeof(*tramp), GFP_KERNEL);
+	if (!tramp)
+		return NULL;
+	tramp->callback = callback;
+	tramp->context = context;
+
+	thread = kthread_create(qdf_thread_trampoline, tramp,
 				"qdf %u", qdf_thread_id++);
-	if (IS_ERR(thread))
+	if (IS_ERR(thread)) {
+		kfree(tramp);
 		return NULL;
+	}
 
 	get_task_struct(thread);
 	wake_up_process(thread);
