diff --git a/tas256x/os_layer/src/tas256x-codec.c b/tas256x/os_layer/src/tas256x-codec.c
index a5ef0a9..b312c1c 100644
--- a/tas256x/os_layer/src/tas256x-codec.c
+++ b/tas256x/os_layer/src/tas256x-codec.c
@@ -514,7 +514,7 @@ static int tas256x_set_dai_fmt(struct snd_soc_dai *dai, unsigned int fmt)
 
 	p_tas256x->mn_fmt = 1;
 	switch (fmt & SND_SOC_DAIFMT_MASTER_MASK) {
-	case SND_SOC_DAIFMT_CBS_CFS:
+	case SND_SOC_DAIFMT_CBC_CFC:
 		asi_cfg_1 = 0x00;
 		asi_cfg_2 = 0x00;
 		break;
diff --git a/tas25xx/src/tas25xx-logic.c b/tas25xx/src/tas25xx-logic.c
index 36d1b8c..ffed95d 100644
--- a/tas25xx/src/tas25xx-logic.c
+++ b/tas25xx/src/tas25xx-logic.c
@@ -161,8 +161,8 @@ int tas25xx_set_dai_fmt_for_fmt(struct tas25xx_priv *p_tas25xx, unsigned int fmt
 		(struct linux_platform *) p_tas25xx->platform_data;
 
 	switch (fmt & SND_SOC_DAIFMT_MASTER_MASK) {
-	case SND_SOC_DAIFMT_CBS_CFS:
-		dev_info(plat_data->dev, "SND_SOC_DAIFMT_CBS_CFS\n");
+	case SND_SOC_DAIFMT_CBC_CFC:
+		dev_info(plat_data->dev, "SND_SOC_DAIFMT_CBC_CFC\n");
 		break;
