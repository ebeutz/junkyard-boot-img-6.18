diff --git a/common/include/linux/version_compat_defs.h b/common/include/linux/version_compat_defs.h
index 88e2840..a688fb4 100644
--- a/common/include/linux/version_compat_defs.h
+++ b/common/include/linux/version_compat_defs.h
@@ -623,7 +623,16 @@ static inline unsigned long
 kbase_mm_get_unmapped_area_helper(struct mm_struct *mm, struct file *filp, unsigned long addr,
 				  unsigned long len, unsigned long pgoff, unsigned long flags)
 {
-#if (KERNEL_VERSION(6, 10, 0) <= LINUX_VERSION_CODE)
+#if (KERNEL_VERSION(7, 0, 0) <= LINUX_VERSION_CODE)
+	/*
+	 * junkyard (lynx-mainline): mm_get_unmapped_area() dropped its mm argument
+	 * and always works on current->mm, which is the only mm the caller passes.
+	 * (The cut-over is in the 6.19..7.3 window; 7.0 is a safe lower bound for
+	 * the only tree this is built against.)
+	 */
+	(void)mm;
+	return mm_get_unmapped_area(filp, addr, len, pgoff, flags);
+#elif (KERNEL_VERSION(6, 10, 0) <= LINUX_VERSION_CODE)
 	return mm_get_unmapped_area(mm, filp, addr, len, pgoff, flags);
 #else
 	return mm->get_unmapped_area(filp, addr, len, pgoff, flags);
