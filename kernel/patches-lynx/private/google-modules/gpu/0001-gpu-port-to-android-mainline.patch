index 0b63ac6..eecaa31 100644
--- a/mali_kbase/Kbuild
+++ b/mali_kbase/Kbuild
@@ -130,6 +130,10 @@ endif
 #
 # ccflags
 #
+# junkyard (lynx-mainline): kbuild no longer appends $(EXTRA_CFLAGS) to every
+# compile (scripts/Makefile.build dropped EXTRA_*FLAGS support), so the flags
+# the Makefile passes that way were silently lost. Restore exactly that.
+ccflags-y += $(EXTRA_CFLAGS)
 ccflags-y += \
     -DMALI_CUSTOMER_RELEASE=$(MALI_CUSTOMER_RELEASE) \
     -DMALI_USE_CSF=$(MALI_USE_CSF) \
@@ -153,8 +157,6 @@ endif
 ccflags-y += \
     -I$(src) \
     -I$(src)/platform/$(MALI_PLATFORM_DIR) \
-    -I$(src)/../../../base \
-    -I$(src)/../../../../include \
     -I$(src)/tests/include
 
