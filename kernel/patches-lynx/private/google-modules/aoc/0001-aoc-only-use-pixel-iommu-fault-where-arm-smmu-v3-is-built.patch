From: junkyard
Subject: [PATCH] aoc: only use pixel-iommu-fault where arm-smmu-v3 is built

aoc_core.ko registers an IOMMU fault handler through pixel-iommu-fault.ko,
which comes from //private/google-modules/iommu/arm-smmu-v3. Only Laguna
adds that package's Kconfig (lga_defconfig: ARM_SMMU_V3_PIXEL,
GOOGLE_ACFW_DEBUG, ...). On gs201 the symbols do not exist, the
kernel_module builds none of its five declared outs, and the lynx dist
fails:

  ERROR: Unable to find acfw-debug.ko ... arm_smmu_v3.ko ...
         pixel-iommu-fault.ko in .../iommu/arm-smmu-v3

gs201 sits behind samsung-iommu, not an Arm SMMUv3, so nothing would ever
report through that path there. Depend on the module only for
soc_is_laguna_or_later (keeping the header-only fault_headers), and
compile the register/unregister calls only when CONFIG_PIXEL_IOMMU_FAULT
is configured. Laguna is unchanged: the option is selected there.
---
diff --git a/BUILD.bazel b/BUILD.bazel
index 2fe1e09..e9bee63 100644
--- a/BUILD.bazel
+++ b/BUILD.bazel
@@ -80,7 +80,6 @@ ddk_module(
         "//private/google-modules/aoc:__subpackages__",
     ],
     deps = [
-        "//private/google-modules/iommu/arm-smmu-v3",
         "//private/google-modules/iommu/arm-smmu-v3:fault_headers",
         "//common:all_headers_aarch64",
         "//private/google-modules/aoc_ipc:ddk_headers",
@@ -90,6 +89,9 @@ ddk_module(
         "//private/google-modules/trusty:trusty_headers",
     ] + select({
         "//private/devices/google/common:soc_is_laguna_or_later": [
+            # Only Laguna configures arm-smmu-v3 (lga_defconfig); on older SoCs
+            # its Kconfig is absent and it builds none of its declared outs.
+            "//private/google-modules/iommu/arm-smmu-v3",
             "//private/google-modules/soc/rdo:rdo_soc_headers",
             "//private/google-modules/soc/rdo:rdo_soc_module",
         ],
diff --git a/aoc.c b/aoc.c
index 9ca1c3a..19c55ea 100644
--- a/aoc.c
+++ b/aoc.c
@@ -1364,8 +1364,8 @@ static struct aoc_service_dev *create_service_device(struct aoc_prvdata *prvdata
 	return dev;
 }
 
-static int aoc_iommu_fault_handler(struct device *dev, unsigned long iova, u32 pasid,
-				   int flags, void *token)
+static int __maybe_unused aoc_iommu_fault_handler(struct device *dev, unsigned long iova,
+						 u32 pasid, int flags, void *token)
 {
 	dev_err(dev, "aoc iommu fault: flags = %#x, addr = %#lx\n", flags, iova);
 
@@ -2973,11 +2973,18 @@ static int aoc_platform_probe(struct platform_device *pdev)
 		goto err_platform_specific_probe;
 	}
 
+#if IS_ENABLED(CONFIG_PIXEL_IOMMU_FAULT)
+	/*
+	 * Only SoCs behind the Pixel arm-smmu-v3 driver (Laguna and later) build
+	 * pixel-iommu-fault; gs101/gs201/zuma use samsung-iommu and have no such
+	 * fault-report path, so there is nothing to register with there.
+	 */
 	rc = pixel_iommu_register_fault_handler(dev, aoc_iommu_fault_handler, NULL);
 	if (rc) {
 		platform_specific_remove(pdev, prvdata);
 		goto err_platform_specific_probe;
 	}
+#endif
 
 	if (aoc_autoload_firmware) {
 		ret = start_firmware_load(dev);
@@ -3018,7 +3025,9 @@ static void aoc_platform_remove(struct platform_device *pdev)
 
 	pr_debug("platform_remove\n");
 
+#if IS_ENABLED(CONFIG_PIXEL_IOMMU_FAULT)
 	pixel_iommu_unregister_fault_handler(&pdev->dev);
+#endif
 
 	dev_pm_domain_detach(&pdev->dev, true);
 
