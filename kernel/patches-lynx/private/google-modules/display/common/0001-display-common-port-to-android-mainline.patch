diff --git a/gs_panel/gs_panel.c b/gs_panel/gs_panel.c
index 87ad3be..8fd49ad 100644
--- a/gs_panel/gs_panel.c
+++ b/gs_panel/gs_panel.c
@@ -8,6 +8,8 @@
  */
 
 #include <linux/platform_device.h>
+#include <linux/fb.h>	/* FB_BLANK_*: no longer pulled in by backlight.h */
+#include <linux/hex.h>
 #include "gs_panel/gs_panel.h"
 
 #include <linux/delay.h>
@@ -31,6 +33,29 @@
 #include "gs_panel_internal.h"
 #include "gs_panel/gs_panel_funcs_defaults.h"
 
+/*
+ * junkyard (lynx-mainline): drm_panel_init() is static upstream now; panels are
+ * meant to come from devm_drm_panel_alloc(), which kzallocs a refcounted
+ * container. This driver embeds its drm_panel in a struct it allocates itself,
+ * so do what drm_panel_init() did and start the refcount at 1 with no
+ * container: drm_panel_add()/drm_panel_remove() then balance their get/put and
+ * the final put (if any) only kfree()s the NULL container -- the 6.18 lifetime
+ * model, where the embedding struct owns the panel.
+ */
+static void jy_drm_panel_init(struct drm_panel *panel, struct device *dev,
+			      const struct drm_panel_funcs *funcs,
+			      int connector_type)
+{
+	INIT_LIST_HEAD(&panel->list);
+	INIT_LIST_HEAD(&panel->followers);
+	mutex_init(&panel->follower_lock);
+	panel->dev = dev;
+	panel->funcs = funcs;
+	panel->connector_type = connector_type;
+	panel->container = NULL;
+	kref_init(&panel->refcount);
+}
+
 /* CONSTANTS */
 
 /* ext_info registers */
@@ -1634,7 +1659,7 @@ static void gs_panel_common_work(struct work_struct *work)
 			      msecs_to_jiffies(ctx->common_work.delay_ms));
 }
 
