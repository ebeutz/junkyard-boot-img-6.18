"""
Loads custom defconfig
"""

exports_files(["custom_defconfig"])

# What .build_kernel passes as --defconfig_fragment=//custom_defconfig_mod:custom_defconfig_<device>.
# kleaf honours only ONE --defconfig_fragment flag (the last), so the shared fragment
# and the per-device one are bundled into a single target per device.
[
    filegroup(
        name = "custom_defconfig_" + device,
        srcs = [
            "custom_defconfig",
            device + "_cmdline_defconfig",
        ],
    )
    for device in [
        "felix",
        "lynx",
    ]
]
