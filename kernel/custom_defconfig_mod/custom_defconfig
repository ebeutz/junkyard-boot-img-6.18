CONFIG_SYSVIPC=y
CONFIG_USER_NS=y
# CONFIG_CMDLINE is NOT here: it is a whole-string override of GKI's own
# CONFIG_CMDLINE, and that string differs between kernel versions, so each device
# carries its own in <device>_cmdline_defconfig (see BUILD.bazel).
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_VHOST_NET=y
# AUTOFS_FS, not the old AUTOFS4_FS: the latter was only a transitional alias and
# is gone in 6.18 (the build then fails: tools/kconfig-check-fragments.sh
# finds the fragment value missing from .config).
# AUTOFS_FS is the real symbol on 6.1 too, so felix is unaffected.
CONFIG_AUTOFS_FS=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4=y
# NFS_V4_1 is in felix_cmdline_defconfig, not here: NFSv4.1 became unconditional
# part of NFS_V4 (the symbol no longer exists on android-mainline, which fails
# kleaf's fragment check), while on 6.1 NFS_V4_2 still depends on it.
CONFIG_NFS_V4_2=y
CONFIG_NFS_V4_1_MIGRATION=y
CONFIG_NFS_V4_2_READ_PLUS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_VT=y
# (CONFIG_HW_CONSOLE was dropped: it was never user-selectable — `default y` under
# VT on 6.1 — and 6.18 removed the symbol entirely, folding it into VT.)
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_DEVMEM=y

# k8s/k3s — process & resource isolation
CONFIG_PID_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NET_CLS_CGROUP=y

# k8s/k3s — networking (kube-proxy iptables mode + flannel VXLAN default)
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VXLAN=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP6_NF_NAT=y

# Shutdown/boot forensics over the network (netconsole).
# felix has ONE USB-C port, so the physical UART is mutually exclusive with both
# the ethernet dongle and the USB gadget, and the bootloader overwrites the
# ramoops CONSOLE region on every boot (its log is the tail of every
# console-ramoops record). The pmsg zone does not exist either: gs201-rmem.dtsi
# splits the 4MB ramoops region into console 2MB + pmsg 2MB with no room left
# for zone headers, and declares no record-size, so dmesg dumps are impossible.
# netconsole is the only instrument that gets kernel messages OFF the device
# without a UART and without a persistent buffer to be clobbered. It is what
# the mainline track uses. NETCONSOLE_DYNAMIC allows retargeting at runtime via
# configfs (the dongle MAC/IP changes between bench and datacenter).
#
# BUILT-IN (=y), not =m, deliberately. The build ships an in-tree module only
# if it is on the GKI list (kernel/kbuild/*-gki-modules.txt) or the device's
# KERNEL_VENDOR_INTREE_MODULES, as Kleaf's exact module manifest did. As =m,
# netconsole.ko would be built and then left out of the image. Built-in
# produces no .ko, so there is nothing to declare. NETCONSOLE_DYNAMIC still
# gives runtime retargeting through /sys/kernel/config/netconsole, which is what
# we need anyway since the dongle's MAC and the target IP differ between the
# bench and the datacenter.
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
