# Per-device build config for lynx (Pixel 7a, Tensor G2 / gs201).
#
# Same SoC as felix — only these board values differ. Included by the Makefile
# via `include devices/$(DEVICE).mk`; a command-line `make VAR=val` overrides.

# ★ BRANCH lynx-linus-mainline: the kernel is Linus Torvalds' tree, built with make.
#
# The device and module code is GrapheneOS's kernel_pixel_6.18 monorepo
# (private/, pinned by kernel/kernel-source.lynx.rev). The kernel at common/ is
# git.kernel.org torvalds/linux.git at the upstream tag AOSP android-mainline
# was last rebased onto (v7.3 at the pin), not an Android Common Kernel. It
# builds with plain kbuild (kernel/kbuild.mk) and the clang AOSP builds that
# release with. There is no Bazel/Kleaf, and nothing else from the monorepo's
# aosp_manifest.xml is fetched.
#
# The Linux tree carries one patch (kernel/patches-lynx/common/0003, a Kconfig
# dependency for the Samsung UART). Everything the vendor modules took from
# ACK -- vendor hooks, ~40 extra exports, ACK-only headers and struct fields --
# is handled in the modules: ported to the upstream equivalent, rebuilt from
# exported API, or compiled out. See kernel/patches/README.md,
# "lynx-linus-mainline".
#
# What that changes here:
#   * kernel release 7.3.0-linus-4k -> /lib/modules/7.3.0-linus-4k/ (common/
#     is at the tag exactly, so setlocalversion adds no -g<sha>).
#   * No KMI, no symbol lists, no MODULE_SIG_FORCE; modules are signed anyway
#     (KERNEL_SIGN_MODULES below).
#   * NOT booted.
#
# History: on lynx-mainline the same device tree ran on AOSP android-mainline
# with Kleaf; before that (main) on GrapheneOS's 6.18 GKI, whose
# CONFIG_MODULE_SIG_FORCE=y is why signing exists. GrapheneOS's build_lynx.sh
# passes --disable_randstruct; RANDSTRUCT is off here anyway (Kconfig default
# RANDSTRUCT_NONE, no defconfig sets it).
KERNEL_SOURCE_KIND  := grapheneos
KERNEL_REPO_URL     := https://gitlab.com/grapheneos/kernel_pixel_6.18
KERNEL_BRANCH       := 17-muzel
# Besides the monorepo (private/, pinned in kernel/kernel-source.lynx.rev), the
# make build needs exactly two things, fetched by clone_kernel_source with plain
# git (no `repo`, no aosp_manifest.xml -- the rest of its `dependencies` group is
# Kleaf and its toolchains):
#
#   common/  Linus' tree at the upstream tag AOSP android-mainline was last
#            rebased onto (the newest "Merge tag 'vX.Y' into android-mainline"
#            below the ACK pin lynx-mainline used).
#   prebuilts/clang/host/linux-x86/clang-$(KERNEL_CLANG_VERSION)
#            the clang AOSP builds that release with; only that one release is
#            checked out of the prebuilt repo, which carries all of them side by
#            side (a full checkout is ~20 GB).
#
# To move: pick the tag and its clang (AOSP common-android-mainline's
# build.config.constants at that merge), update all four values, rebuild.
KERNEL_LINUX_URL := https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git
KERNEL_LINUX_TAG := v7.3
KERNEL_LINUX_REV := c03c1a14507dfaf8b856c2608f9ac216021fc222
KERNEL_CLANG_URL := https://android.googlesource.com/platform/prebuilts/clang/host/linux-x86
KERNEL_CLANG_REV := 383d35d98a3e1635d2e3a88d866b125d7d20a0c1
KERNEL_CLANG_VERSION := r596125

# ── The make build (kernel/kbuild.mk) ────────────────────────────────────────
# What lynx's and gs201's device_build() BUILD.bazel targets described, as make
# variables. Paths without a prefix are relative to kernel/source-lynx/; the
# KERNEL_BASE_DEFCONFIG, KERNEL_LOCAL_FRAGMENTS, KERNEL_EXTRA_KCONFIGS and
# KERNEL_GKI_MODULES ones to this repo.
#
# Linus' tree at common/. Its defconfig, Kconfig.gki and GKI module list are
# this repo's (kernel/kbuild/), so the tree itself needs no new files.
KERNEL_TREE            := common
# Sign every module with the build's key at install (see kernel/kbuild.mk).
KERNEL_SIGN_MODULES    := 1
KERNEL_BASE_DEFCONFIG   = $(REPO)/kernel/kbuild/linus_gki_defconfig
KERNEL_EXTRA_KCONFIGS  := kernel/kbuild/linus_Kconfig.gki
KERNEL_GKI_MODULES     := kernel/kbuild/linus-gki-modules.txt
# Not an ACK, so no -D__ANDROID_COMMON_KERNEL__ (vendor code picks the upstream
# paths without it).
KERNEL_KCFLAGS         :=
# gs201_base then lynx, as device_build() layered them.
KERNEL_DEFCONFIG_FRAGMENTS := \
	private/devices/google/gs201/gs201_defconfig \
	private/devices/google/lynx/lynx_defconfig
KERNEL_LOCAL_FRAGMENTS := \
	kernel/custom_defconfig_mod/custom_defconfig \
	kernel/custom_defconfig_mod/lynx_cmdline_defconfig
KERNEL_KCONFIG_EXTS := \
	private/devices/google/gs201/Kconfig.ext.gs201 \
	private/devices/google/lynx/Kconfig.ext.lynx
# build.config.gs201's prefixes, which Kconfig.ext.gs201 expands.
KERNEL_KCONFIG_VARS = \
	KCONFIG_EXT_MODULES_PREFIX=$(SRC)/ \
	KCONFIG_SOC_GS_PREFIX=$(SRC)/private/google-modules/soc/gs/
# Out-of-tree modules: generated by tools/bazel2kbuild.py (kernel/kbuild/README.md).
KERNEL_EXT_MODULES_MK = $(REPO)/kernel/kbuild/lynx-modules.mk
# In-tree modules the device ships beside the GKI ones (gs201's GS201_MODULE_OUTS).
KERNEL_VENDOR_INTREE_MODULES := \
	drivers/gpu/drm/display/drm_display_helper.ko \
	drivers/i2c/i2c-dev.ko \
	drivers/nvmem/at24.ko \
	drivers/perf/arm_dsu_pmu.ko \
	drivers/scsi/sg.ko \
	drivers/spi/spidev.ko \
	drivers/watchdog/softdog.ko \
	lib/crc/crc8.ko
KERNEL_VENDOR_RAMDISK_LISTS := \
	private/devices/google/gs201/vendor_ramdisk.modules.gs201 \
	private/devices/google/lynx/vendor_ramdisk.modules.lynx
# Device tree: lynx/dts builds gs201's base dtbs (through its gs201 -> gs201/dts
# link) and the lynx overlays. dtb.img and dtbo.img take them in these orders.
KERNEL_DTSTREE     := private/devices/google/lynx/dts
KERNEL_DTC_INCLUDE := private/google-modules/soc/gs/include/dtc
KERNEL_DTBS := \
	gs201/gs201-a0.dtb \
	gs201/gs201-b0.dtb \
	gs201/gs201-b0_v2-ipop.dtb
KERNEL_DTBOS := \
	gs201-lynx-dev1_0.dtbo \
	gs201-lynx-proto1_0.dtbo \
	gs201-lynx-proto1_1.dtbo \
	gs201-lynx-evt1_0.dtbo \
	gs201-lynx-evt1_1.dtbo \
	gs201-lynx-evt1_0-wingboard.dtbo \
	gs201-lynx-dvt1_0.dtbo \
	gs201-lynx-dvt1_0-gain1.dtbo \
	gs201-lynx-pvt1_0.dtbo \
	gs201-lynx-mp1_0.dtbo

# tools/bazel2kbuild.py inputs, for regenerating the module Kbuild files and
# kernel/kbuild/lynx-modules.mk when the vendor tree's BUILD files change:
#   make -f kernel/kbuild.mk DEVICE=lynx kbuild-regen
# (then refresh kernel/patches-lynx/private/..., see kernel/kbuild/README.md).
# ROOTS are gs201_base's and lynx's device_build() ext_modules; FLAGS what
# gs201/device.bazelrc and lynx/device.bazelrc set; KERNEL_HEADERS the
# kernel_build's ddk_module_headers, then its base kernel's.
KBUILD_GEN_ROOTS := \
	//private/devices/google/gs201:gs201_soc \
	//private/google-modules/amplifiers/audiometrics \
	//private/google-modules/aoc \
	//private/google-modules/aoc/alsa \
	//private/google-modules/aoc/usb:aoc.usb \
	//private/google-modules/bms \
	//private/google-modules/bms/misc:bms-misc \
	//private/google-modules/display/common/gs_drm \
	//private/google-modules/display/common/gs_panel \
	//private/google-modules/display/samsung:display.samsung \
	//private/google-modules/edgetpu/janeiro/drivers/edgetpu:edgetpu.janeiro \
	//private/google-modules/fingerprint/goodix/fps_touch_handler \
	//private/google-modules/fingerprint/goodix/gw9608 \
	//private/google-modules/gpu/mali_kbase \
	//private/google-modules/gpu/mali_pixel \
	//private/google-modules/gxp/gs201:gxp \
	//private/google-modules/lwis:lwis.busan \
	//private/google-modules/misc/sscoredump \
	//private/google-modules/power/mitigation:bcl \
	//private/google-modules/power/reset \
	//private/google-modules/soc/gs/drivers/misc/sscoredump \
	//private/google-modules/soc/gs/drivers/soc/google/eh \
	//private/google-modules/soc/gs/drivers/soc/google/gsa \
	//private/google-modules/trusty \
	//private/google-modules/video/gchips:video.gchips \
	//private/devices/google/lynx/display:drm_panel.google \
	//private/google-modules/amplifiers/cs35l41 \
	//private/google-modules/amplifiers/cs40l26 \
	//private/google-modules/amplifiers/snd_soc_wm_adsp:snd-soc-wm-adsp \
	//private/google-modules/bluetooth/qcom:bluetooth.qcom \
	//private/google-modules/gps/broadcom/bcm47765 \
	//private/google-modules/nfc \
	//private/google-modules/radio/samsung/s5300:cpif \
	//private/google-modules/touch/common:touch.common \
	//private/google-modules/touch/focaltech/ft3658 \
	//private/google-modules/touch/goodix \
	//private/google-modules/wlan/qcom/wcn6740/cnss2 \
	//private/google-modules/wlan/qcom/wcn6740/wlan/qcacld-3.0
KBUILD_GEN_FLAGS := \
	//private/devices/google/common:soc=gs201 \
	//private/google-modules/soc/gs/drivers/soc/google/eh:ip_idle=exynos_ip_idle \
	//private/google-modules/soc/gs:gs_soc_module=//private/devices/google/gs201:gs201_soc \
	//private/google-modules/touch/common:samsung_drm=true
KBUILD_GEN_CONDITIONS := //build/kernel/kleaf:allow_ddk_unsafe_headers_set
KBUILD_GEN_KERNEL_HEADERS := \
	//private/google-modules/soc/gs:linus_compat_headers \
	//common:all_headers_aarch64
# Linus' tree has no BUILD.bazel; its DDK header sets are described here.
KBUILD_GEN_KERNEL_PKG := kernel/kbuild/linux-ddk-headers.json

# lynx full OTA (Android 16, cp1a) — the direct parallel to felix's cp1a image:
# same Android major => same vendor-firmware ABI expectations. Newer Android-17
# cp2a images exist (lynx-ota-cp2a.260705.006-f4d6d546.zip,
# sha256 f4d6d546e812da1ebbc9d4028025aa2d3da0e162935e95693e8185d6477e0f27) — swap
# URL+hash to track those. Pinned by content hash.
OTA_URL    := https://dl.google.com/dl/android/aosp/lynx-ota-cp1a.260505.005-fd391772.zip
OTA_SHA256 := fd391772de040173a19d97bc080cccb6785ac91d3b2b6b770bcef0fb4ea4018f

# ★ lynx's `super` is BYTE-IDENTICAL to felix's — this is measured, not assumed.
#
#   39271JEHN00059 (lynx, MP1.0, bootloader lynx-16.4-14540572), 2026-08-05:
#     fastboot getvar partition-size:super    -> 0x1fc800000 = 8531214336 = 8136 MiB
#     fastboot getvar partition-size:userdata -> 0x1b7a615000 = 109.9 GiB
#
# So the A/B half, and therefore SIZE, are the same as felix. userdata DOES
# differ (felix is 229 GiB, this is a 128 GB 7a) but nothing here keys on its
# size — flash-ssh.sh finds the staging partition by GPT label, not by node or
# capacity, which is why there is deliberately no USERDATA_DEV here. Set that in
# the environment if a specific device ever needs the override.
SIZE        := 4000M
SUPER_BYTES := 8531214336
HOSTNAME    := lynx

# ⚠ NOT YET BOOTED. The values above are read off real hardware, but no image
# built from this fragment has been flashed yet. The kernel builds (every module
# links, passes modpost and depmod) and that is all it has been shown to do, so
# treat the first `just lynx` on hardware as bring-up, not a rebuild.
#
# The bench unit 39271JEHN00059 (MP1.0, bootloader lynx-16.4-14540572) reports
# `unlocked: yes`, so the fastboot path is open. Note that
# `secure-boot: PRODUCTION` still holds: our repacked boot chain is unsigned, so
# it needs the same per-slot `fastboot oem disable-verity` / `disable-verification`
# treatment felix does, and the same vbmeta flag normalisation on the INACTIVE
# slot before an OTA (see flash-ssh.sh) — that per-slot trap is not felix-specific.
#
# The boot-chain partition set is confirmed identical to felix — boot, init_boot,
# vendor_boot, vendor_kernel_boot, dtbo, vbmeta, vbmeta_system, vbmeta_vendor and
# pvmfw all report has-slot:yes — so pixel-ota's flash list needs no change.

# Human-facing model name, used in the operator-facing provisioning README.
DEVICE_MODEL := Pixel 7a
