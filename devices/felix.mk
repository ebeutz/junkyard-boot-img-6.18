# Per-device build config for felix (Pixel Fold, Tensor G2 / gs201).
#
# Included by the Makefile via `include devices/$(DEVICE).mk`. These are the ONLY
# values that differ between gs201 Pixels — everything else in the tree is
# SoC-level or userspace and is shared. A command-line `make VAR=val` (and the
# justfile's size=/hostname= variables) still beats anything set here.

KERNEL_SOURCE_KIND  := aosp
KERNEL_BRANCH       := android-gs-felix-6.1-android16
# The clang the kernel builds with: aosp/build.config.constants CLANG_VERSION at
# the pinned aosp/ revision. clone_kernel_source checks out only this release
# of the clang prebuilt (tools/sparse-prebuilts.sh).
KERNEL_CLANG_VERSION := r487747c

# ── The make build (kernel/kbuild.mk) ────────────────────────────────────────
# What felix's and gs201's kernel_build / kernel_module_group BUILD.bazel
# targets described (the 6.1 tree's Kleaf targets, before device_build()), as
# make variables. Paths without a prefix are relative to kernel/source-felix/;
# the KERNEL_LOCAL_FRAGMENTS and KERNEL_GKI_MODULES ones to this repo.
#
# The GKI is built from source (what --config=use_source_tree_aosp did), in the
# same make build as the modules, from ACK's own gki_defconfig.
KERNEL_TREE            := aosp
KERNEL_BASE_DEFCONFIG   = $(KTREE)/arch/arm64/configs/gki_defconfig
KERNEL_EXTRA_KCONFIGS  :=
KERNEL_GKI_MODULES     := kernel/kbuild/android14-6.1-gki-modules.txt
# ACK's COMMON_KCFLAGS, which Kleaf built this kernel and its modules with.
KERNEL_KCFLAGS         := -D__ANDROID_COMMON_KERNEL__
# Modules stay unsigned, as with Kleaf (gs201_defconfig turns
# CONFIG_MODULE_SIG_ALL off and the 6.1 GKI does not force signatures).
KERNEL_SIGN_MODULES    := 0
KERNEL_DEFCONFIG_FRAGMENTS := \
	private/devices/google/gs201/gs201_defconfig \
	private/devices/google/felix/felix_defconfig
KERNEL_LOCAL_FRAGMENTS := \
	kernel/custom_defconfig_mod/custom_defconfig \
	kernel/custom_defconfig_mod/felix_cmdline_defconfig
KERNEL_KCONFIG_EXTS := \
	private/devices/google/gs201/Kconfig.ext.gs201 \
	private/devices/google/felix/Kconfig.ext.felix
# build.config.gs201's prefixes, which Kconfig.ext.gs201 expands.
KERNEL_KCONFIG_VARS = \
	KCONFIG_EXT_MODULES_PREFIX=$(SRC)/ \
	KCONFIG_SOC_GS_PREFIX=$(SRC)/private/google-modules/soc/gs/
# Out-of-tree modules: generated by tools/bazel2kbuild.py (kernel/kbuild/README.md).
KERNEL_EXT_MODULES_MK = $(REPO)/kernel/kbuild/felix-modules.mk
# In-tree modules the device ships beside the GKI ones (gs201's GS201_MODULE_OUTS).
KERNEL_VENDOR_INTREE_MODULES := \
	drivers/gpu/drm/display/drm_display_helper.ko \
	drivers/i2c/i2c-dev.ko \
	drivers/misc/eeprom/at24.ko \
	drivers/perf/arm_dsu_pmu.ko \
	drivers/scsi/sg.ko \
	drivers/spi/spidev.ko \
	drivers/watchdog/softdog.ko \
	net/mac80211/mac80211.ko \
	net/wireless/cfg80211.ko
KERNEL_VENDOR_RAMDISK_LISTS := \
	private/devices/google/gs201/vendor_ramdisk.modules.gs201 \
	private/devices/google/felix/vendor_ramdisk.modules.felix
# Device tree: felix/dts builds gs201's base dtbs and the felix overlays.
# dtb.img and dtbo.img take them in these orders (GS201_DTBS, FELIX_DTBOS).
KERNEL_DTSTREE     := private/devices/google/felix/dts
KERNEL_DTC_INCLUDE := private/google-modules/soc/gs/include/dtc
KERNEL_DTBS := \
	gs201/gs201-a0.dtb \
	gs201/gs201-b0.dtb \
	gs201/gs201-b0_v2-ipop.dtb
KERNEL_DTBOS := \
	gs201-felix-dev1_0.dtbo \
	gs201-felix-proto1_0.dtbo \
	gs201-felix-proto1_0_testDDR.dtbo \
	gs201-felix-proto1_1.dtbo \
	gs201-felix-proto1_1_testDDR.dtbo \
	gs201-felix-evt1_0.dtbo \
	gs201-felix-evt1_0-wingboard.dtbo \
	gs201-felix-evt1_0-doe.dtbo \
	gs201-felix-dvt1_0.dtbo \
	gs201-felix-pvt1_0.dtbo \
	gs201-felix-mp.dtbo

# tools/bazel2kbuild.py inputs, for regenerating kernel/kbuild/felix-modules.mk
# when the vendor tree's BUILD files change:
#   make -f kernel/kbuild.mk DEVICE=felix kbuild-regen
# The 6.1 tree's modules are all Makefile-based kernel_module()s, so for felix
# that writes only the manifest, no Kbuild. ROOTS is felix's kernel_ext_modules
# group (it includes gs201's); FLAGS what felix/device.bazelrc sets. //common is
# an alias package selecting the kernel tree (aosp/, what
# --config=use_source_tree_aosp chose), described by KBUILD_GEN_KERNEL_PKG.
KBUILD_GEN_ROOTS := //private/devices/google/felix:kernel_ext_modules
KBUILD_GEN_FLAGS := \
	//private/devices/google/common:kernel=//private/devices/google/felix:kernel \
	//private/google-modules/soc/gs:gs_soc_module=//private/devices/google/felix:gs201_soc.felix
KBUILD_GEN_CONDITIONS :=
KBUILD_GEN_KERNEL_HEADERS := //aosp:all_headers
KBUILD_GEN_KERNEL_PKG := kernel/kbuild/felix-common-aliases.json
KBUILD_GEN_KERNEL_DIR := common

# felix full OTA (Android 16, cp1a). sync_vendor_firmware extracts /vendor/firmware
# (aoc.bin, ...) from this. Pinned by content hash so a rotated/corrupt OTA fails
# the sync loudly instead of silently changing the vendor firmware. The zip's
# content matches the `-7a13341e` prefix Google embeds in the URL.
OTA_URL    := https://dl.google.com/dl/android/aosp/felix-ota-cp1a.260405.005-7a13341e.zip
OTA_SHA256 := 7a13341eb090a7656e67e1244b832420ffe6c7c0f2530d544ab9e7e23c69ff56

# Rootfs image size — ONE HALF of `super`, not all of it.
#
# ⚠ This was 8100M before rootfs A/B landed, when one rootfs filled the whole
# partition. super is 8136 MiB split into two 4068 MiB slots that the initramfs
# maps one at a time (see the rootfs-slot dracut module); 4000M leaves a little
# slack inside a half. Raising it past 4068 silently produces an image that
# overruns slot A into slot B.
SIZE     := 4000M
HOSTNAME := fold

# The whole `super` partition, for the full-flash super.img. Must match the
# TARGET device, not the build host.
#
# MEASURED: `fastboot getvar partition-size:super` = 0x1FC800000 = 8136 MiB
# exactly. Confirmed identical on all three felixes.
SUPER_BYTES := 8531214336

# Human-facing model name, used in the operator-facing provisioning README.
DEVICE_MODEL := Pixel Fold
